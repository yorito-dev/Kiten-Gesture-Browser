<Window x:Class="TabBrowser.BookmarkManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ブックマーク"
        Width="820"
        Height="500"
        MinWidth="640"
        MinHeight="360"
        Background="#101114"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DarkDialogButtonStyle}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="DialogComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#181B22" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <TextBlock Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{Binding DisplayName}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#284B73" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D2530" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#284B73" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B7280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#181B22" />
            <Setter Property="BorderBrush" Value="#343842" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DialogComboBoxItemStyle}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="#343842"
                                                BorderThickness="1">
                                            <Grid>
                                                <TextBlock Margin="8,0,28,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           Foreground="#F3F4F6"
                                                           Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Path Width="8"
                                                      Height="5"
                                                      Margin="0,0,9,0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#F3F4F6" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#1D2530" />
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#3EA6D9" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#3EA6D9" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#181B22"
                                            BorderBrush="#3EA6D9"
                                            BorderThickness="1">
                                        <ScrollViewer Background="#181B22"
                                                      SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Foreground="#F3F4F6"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="ブックマーク" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Height="30"
                     Padding="10,5"
                     Foreground="#F3F4F6"
                     Background="#181B22"
                     BorderBrush="#343842"
                     BorderThickness="1"
                     CaretBrush="#F3F4F6"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged" />
            <TextBlock Grid.Column="1"
                       Margin="10,0,6,0"
                       Foreground="#D1D5DB"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Text="並び順" />
            <ComboBox x:Name="SortModeBox"
                      Grid.Column="2"
                      Height="30"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Mode"
                      SelectionChanged="SortModeBox_SelectionChanged"
                      Style="{StaticResource DialogComboBoxStyle}" />
            <Button Grid.Column="3"
                    Width="70"
                    Height="30"
                    Margin="8,0,0,0"
                    Content="クリア"
                    Click="ClearSearchButton_Click"
                    Style="{StaticResource DialogButtonStyle}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#11141A"
                    BorderBrush="#303541"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="10,8,10,7"
                               Foreground="#D1D5DB"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="フォルダ" />
                    <StackPanel DockPanel.Dock="Bottom"
                                Margin="10,6,10,10">
                        <Button x:Name="FolderCreateButton"
                                Margin="0,0,0,6"
                                Content="新規フォルダ"
                                Click="FolderCreateButton_Click"
                                Style="{StaticResource DialogButtonStyle}" />
                        <Button x:Name="FolderRenameButton"
                                Margin="0,0,0,6"
                                Content="名前変更"
                                IsEnabled="False"
                                Click="FolderRenameButton_Click"
                                Style="{StaticResource DialogButtonStyle}" />
                        <Button x:Name="FolderMoveButton"
                                Margin="0,0,0,6"
                                Content="移動"
                                IsEnabled="False"
                                Click="FolderMoveButton_Click"
                                Style="{StaticResource DialogButtonStyle}" />
                        <Button x:Name="FolderDeleteButton"
                                Margin="0"
                                Content="フォルダ削除"
                                IsEnabled="False"
                                Click="FolderDeleteButton_Click"
                                Style="{StaticResource DialogButtonStyle}" />
                    </StackPanel>
                    <ListBox x:Name="FolderList"
                             ItemsSource="{Binding BookmarkFolders}"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="FolderList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="FolderList_PreviewMouseMove"
                             DragOver="FolderList_DragOver"
                             DragLeave="FolderList_DragLeave"
                             Drop="FolderList_Drop"
                             SelectionChanged="FolderList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#F3F4F6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1D2530" />
                                    </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#284B73" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsDropRejected}" Value="True">
                                    <Setter Property="Background" Value="#4A2730" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDragTarget}" Value="True">
                                    <Setter Property="Background" Value="#285A4A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding IndentMargin}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Margin="10,6,8,6"
                                               Foreground="#F3F4F6"
                                               FontSize="12"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="0,6,10,6"
                                               Foreground="#9CA3AF"
                                               FontSize="11"
                                               Text="{Binding CountText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="#101114" />

            <DataGrid x:Name="BookmarkGrid"
                      Grid.Column="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      AllowDrop="True"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      ItemsSource="{Binding BookmarkView}"
                      MouseDoubleClick="BookmarkGrid_MouseDoubleClick"
                      PreviewMouseLeftButtonDown="BookmarkGrid_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="BookmarkGrid_PreviewMouseMove"
                      DragOver="BookmarkGrid_DragOver"
                      Drop="BookmarkGrid_Drop"
                      SelectionChanged="BookmarkGrid_SelectionChanged"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      Background="#11141A"
                      Foreground="#F3F4F6"
                      BorderBrush="#303541"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#303541"
                      RowBackground="#171A22"
                      AlternatingRowBackground="#141720"
                      ColumnHeaderHeight="30"
                      RowHeight="34">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="#1D2028" />
                        <Setter Property="Foreground" Value="#D1D5DB" />
                        <Setter Property="BorderBrush" Value="#303541" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Padding" Value="8,0" />
                    </Style>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#284B73" />
                                <Setter Property="BorderBrush" Value="#73B7FF" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Foreground" Value="#F3F4F6" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="タイトル"
                                        Binding="{Binding Title}"
                                        Width="2*" />
                    <DataGridTextColumn Header="フォルダ"
                                        Binding="{Binding FolderPath}"
                                        Width="1.4*" />
                    <DataGridTextColumn Header="URL"
                                        Binding="{Binding Url}"
                                        Width="3*" />
                    <DataGridTextColumn Header="確認"
                                        Binding="{Binding CheckStatusText}"
                                        Width="110" />
                    <DataGridTextColumn Header="回数"
                                        Binding="{Binding OpenCount}"
                                        Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,8,0,8"
                   Style="{StaticResource DarkStatusTextStyle}" />

        <DockPanel Grid.Row="4" LastChildFill="False">
            <WrapPanel>
                <Button x:Name="ImportButton"
                        Content="取込"
                        Click="ImportButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="ExportHtmlButton"
                        Content="HTML出力"
                        Click="ExportHtmlButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="BackupButton"
                        Content="バックアップ"
                        Click="BackupButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="RestoreButton"
                        Content="復元"
                        Click="RestoreButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="OpenButton"
                        Content="開く"
                        IsEnabled="False"
                        Click="OpenButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="EditButton"
                        Content="編集"
                        IsEnabled="False"
                        Click="EditButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="MoveSelectedButton"
                        Content="フォルダへ移動"
                        IsEnabled="False"
                        Click="MoveSelectedButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="MergeDuplicatesButton"
                        Content="重複整理"
                        Click="MergeDuplicatesButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="CheckBookmarksButton"
                        Content="存在確認"
                        Click="CheckBookmarksButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="DeleteButton"
                        Content="削除"
                        IsEnabled="False"
                        Click="DeleteButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
            </WrapPanel>
            <Button DockPanel.Dock="Right"
                    Content="閉じる"
                    Click="CloseButton_Click"
                    Style="{StaticResource DialogButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
