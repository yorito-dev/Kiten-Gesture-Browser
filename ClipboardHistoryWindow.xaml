<Window x:Class="TabBrowser.ClipboardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="クリップボード履歴"
        Width="720"
        Height="560"
        MinWidth="520"
        MinHeight="360"
        Background="#101114"
        Foreground="#F3F4F6"
        PreviewKeyDown="Window_PreviewKeyDown"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Text="クリップボード履歴" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="PauseButton"
                        MinWidth="72"
                        Margin="0,0,6,0"
                        Click="PauseButton_Click"
                        Content="一時停止" />
                <Button Margin="0,0,6,0"
                        Click="ClearButton_Click"
                        Content="全削除" />
                <Button Click="SettingsButton_Click"
                        Content="設定" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="SearchBox"
                 Grid.Row="1"
                 Height="32"
                 Margin="0,10,0,10"
                 VerticalContentAlignment="Center"
                 TextChanged="SearchBox_TextChanged"
                 ToolTip="履歴を検索" />

        <Grid Grid.Row="2">
            <ListBox x:Name="HistoryList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border x:Name="ItemBorder"
                                            Padding="10,8"
                                            Background="#151922"
                                            BorderBrush="#2A3340"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1C2531" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#46566A" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#20364A" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#67B7DC" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="#7DD3FC"
                                           FontWeight="SemiBold"
                                           Text="{Binding TypeText}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           Text="{Binding CapturedAt, StringFormat={}{0:HH:mm:ss}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="6,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="#F3F4F6"
                                       MaxHeight="40"
                                       Text="{Binding PreviewText}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <Button Margin="0,0,4,0"
                                        Click="CopyItemButton_Click"
                                        Content="コピー" />
                                <Button Margin="0,0,4,0"
                                        Click="OpenItemButton_Click"
                                        Content="開く"
                                        IsEnabled="{Binding CanOpen}" />
                                <Button Click="DeleteItemButton_Click"
                                        Content="削除" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#94A3B8"
                       FontSize="14"
                       Text="履歴はありません" />
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="2,8,2,0"
                   Foreground="#94A3B8"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
