<Window x:Class="TabBrowser.RestoreIncompleteWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Kiten - 復元未完了"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{StaticResource DarkWindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Foreground="{StaticResource DarkControlForegroundBrush}"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Text="データの復元が完了していません" />

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,18"
                   Foreground="{StaticResource DarkControlSubtleForegroundBrush}"
                   FontSize="13"
                   LineHeight="21"
                   TextWrapping="Wrap"
                   Text="Kitenを終了したまま、復旧ツールで復元開始前の状態へ戻してください。復旧が完了するまで、データは開きません。" />

        <Button Grid.Row="2"
                Width="92"
                HorizontalAlignment="Right"
                automation:AutomationProperties.Name="警告を閉じる"
                Content="閉じる"
                IsCancel="True"
                IsDefault="True"
                Style="{StaticResource DarkDialogButtonStyle}" />
    </Grid>
</Window>
