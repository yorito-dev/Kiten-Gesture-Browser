<UserControl x:Class="TabBrowser.Views.WorkspaceOSView"
             x:Name="WorkspaceRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TabBrowser.Views"
             Focusable="True"
             Loaded="UserControl_Loaded"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             PreviewMouseDown="UserControl_PreviewMouseDown"
             Background="#101114">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="HyperSearchButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#23262D" />
            <Setter Property="BorderBrush" Value="#343842" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="RecentFilterButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Foreground" Value="#D1D5DB" />
            <Setter Property="Background" Value="#20242E" />
            <Setter Property="BorderBrush" Value="#343842" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="WorkspaceNumberButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#D1D5DB" />
            <Setter Property="Background" Value="#20242E" />
            <Setter Property="BorderBrush" Value="#343842" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#273244" />
                    <Setter Property="BorderBrush" Value="#64748B" />
                </Trigger>
                <Trigger Property="Tag" Value="WorkspaceCardDragOver">
                    <Setter Property="Background" Value="#315A78" />
                    <Setter Property="BorderBrush" Value="#7DD3FC" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#2E3B4F" />
                    <Setter Property="BorderBrush" Value="#8AB4F8" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#101114">
    <Grid x:Name="WorkspaceContent"
          Background="#101114">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="{x:Type ColumnDefinition}">
                        <Setter Property="Width" Value="300" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsWorkspaceSidePanelVisible, ElementName=WorkspaceRoot}" Value="False">
                                <Setter Property="Width" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Background="#151820"
                BorderBrush="#262A33"
                BorderThickness="0,0,1,0">
            <views:TabShelfView x:Name="TabShelf"
                                DataContext="{Binding TabShelf}"
                                QuickLookRequested="TabShelf_QuickLookRequested"
                                QuickLookSelectionChanged="TabShelf_QuickLookSelectionChanged"
                                TabTransferRequested="TabShelf_TabTransferRequested" />
        </Border>

        <Border Grid.Row="0"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Background="#11141A"
                BorderBrush="#262A33"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <ItemsControl VerticalAlignment="Center"
                                  PreviewMouseWheel="WorkspaceNumbers_PreviewMouseWheel"
                                  ItemsSource="{Binding Workspaces}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SwitchWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Index}"
                                        ToolTip="{Binding DisplayName}"
                                        ToolTipService.InitialShowDelay="250"
                                        ToolTipService.ShowDuration="60000"
                                        AllowDrop="True"
                                        DragEnter="WorkspaceNumber_DragEnter"
                                        DragOver="WorkspaceNumber_DragOver"
                                        DragLeave="WorkspaceNumber_DragLeave"
                                        Drop="WorkspaceNumber_Drop"
                                        Style="{StaticResource WorkspaceNumberButtonStyle}">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="名前を変更..."
                                                      Click="RenameWorkspaceMenuItem_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock MaxWidth="260"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#F3F4F6"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="{Binding CurrentWorkspaceTitle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <DockPanel Grid.Column="2"
                           HorizontalAlignment="Right"
                           Width="300"
                           LastChildFill="True">
                    <Button x:Name="HyperSearchToggleButton"
                            DockPanel.Dock="Right"
                            Width="54"
                            Height="26"
                            Margin="8,0,0,0"
                            Padding="0"
                            Command="{Binding ToggleHyperSearchCommand}"
                            Content="検索"
                            Style="{StaticResource HyperSearchButtonStyle}" />
                    <Button x:Name="RecentItemsToggleButton"
                            DockPanel.Dock="Right"
                            Width="54"
                            Height="26"
                            Margin="8,0,0,0"
                            Padding="0"
                            Command="{Binding ToggleRecentItemsCommand}"
                            Content="最近"
                            Style="{StaticResource HyperSearchButtonStyle}" />
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="最近削除した項目"
                            Click="DeletedItemsButton_Click" Style="{StaticResource HyperSearchButtonStyle}" />
                    <TextBlock DockPanel.Dock="Right"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#FBBF24"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="保存中"
                               Visibility="{Binding IsWorkspaceSaving, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#9CA3AF"
                               FontSize="12"
                               Text="{Binding StatusText}"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#10131A"
                    BorderBrush="#262A33"
                    BorderThickness="0,0,0,1">
                <DockPanel Margin="10,0"
                           LastChildFill="True">
                    <Button DockPanel.Dock="Left"
                            Width="52"
                            Height="24"
                            Margin="0,0,8,0"
                            Padding="0"
                            Command="{Binding GoToParentFolderCommand}"
                            Content="上へ"
                            Style="{StaticResource HyperSearchButtonStyle}"
                            Visibility="{Binding IsInsideFolder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               Foreground="#6B7280"
                               FontSize="11"
                               Text="{Binding CurrentLocationSummary}" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#D1D5DB"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding CurrentLocationTitle}"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <views:WorkspaceCanvasView x:Name="WorkspaceCanvas"
                                       Grid.Row="1" />
        </Grid>

        <Border x:Name="HyperSearchPanel"
                Grid.Row="1"
                Grid.Column="2"
                Background="#14161D"
                BorderBrush="#262A33"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsHyperSearchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="12,10,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="#9CA3AF"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="HYPER SEARCH" />
                    <TextBlock Grid.Column="1"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#6B7280"
                               FontSize="11"
                               Text="{Binding SearchResultSummary}" />
                    <Button Grid.Column="2"
                            Width="54"
                            Height="26"
                            Padding="0"
                            Command="{Binding ToggleHyperSearchCommand}"
                            Content="閉じる"
                            Style="{StaticResource RecentFilterButtonStyle}" />
                </Grid>

                <StackPanel Grid.Row="1"
                            Margin="12,0,12,10">
                        <TextBox Height="30"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center"
                                 Background="#10131A"
                                 BorderBrush="#343842"
                                 BorderThickness="1"
                                 Foreground="#F3F4F6"
                                 CaretBrush="#F3F4F6"
                                 FontSize="12"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,8,0,0"
                                    Orientation="Horizontal">
                            <Button Command="{Binding SearchCommand}"
                                    Content="検索"
                                    Style="{StaticResource HyperSearchButtonStyle}" />
                            <Button Margin="6,0,0,0"
                                    Command="{Binding ClearSearchCommand}"
                                    Content="消去"
                                    Style="{StaticResource HyperSearchButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="WorkspaceSearchResultsList"
                                 ItemsSource="{Binding SearchResults}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 PreviewMouseRightButtonDown="WorkspaceSearchResultsList_PreviewMouseRightButtonDown"
                                 SelectionChanged="WorkspaceSearchResultsList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ContextMenu>
                                <ContextMenu Background="#171B22"
                                             BorderBrush="#3A404D"
                                             BorderThickness="1">
                                    <MenuItem Header="プレビュー"
                                              Click="WorkspaceSearchPreviewMenuItem_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="10,0,10,8"
                                            Padding="0"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.GoToSearchResultCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Click="WorkspaceSearchResult_Click"
                                            Cursor="Hand">
                                        <Border Padding="10"
                                                Background="#1A1D25"
                                                BorderBrush="#343842"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Foreground="#8AB4F8"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding TypeLabel}" />
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Foreground="#9CA3AF"
                                                               FontSize="10"
                                                               Text="{Binding WorkspaceLabel}"
                                                               TextAlignment="Right"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,5,0,0"
                                                           Foreground="#F9FAFB"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="2"
                                                           Margin="0,4,0,0"
                                                           Foreground="#D1D5DB"
                                                           FontSize="10"
                                                           Text="{Binding Subtitle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="3"
                                                           Margin="0,4,0,0"
                                                           Foreground="#9CA3AF"
                                                           FontSize="10"
                                                           Text="{Binding Detail}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Margin="16"
                                   VerticalAlignment="Center"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Text="検索結果がありません"
                                   TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchResults}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

        <Border x:Name="RecentItemsPanel"
                Grid.Row="1"
                Grid.Column="2"
                Background="#14161D"
                BorderBrush="#262A33"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsRecentItemsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,10,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#E5E7EB"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="最近使った項目" />
                    <TextBlock Grid.Column="1"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#6B7280"
                               FontSize="11"
                               Text="{Binding RecentItemSummary}" />
                    <Button Grid.Column="2"
                            Width="54"
                            Height="26"
                            Padding="0"
                            Command="{Binding ToggleRecentItemsCommand}"
                            Content="閉じる"
                            Style="{StaticResource HyperSearchButtonStyle}" />
                </Grid>

                <StackPanel Grid.Row="1"
                            Margin="12,0,12,10"
                            Orientation="Horizontal">
                    <Button Command="{Binding SetRecentFilterCommand}"
                            CommandParameter="All"
                            Content="すべて"
                            Style="{StaticResource RecentFilterButtonStyle}" />
                    <Button Margin="5,0,0,0"
                            Command="{Binding SetRecentFilterCommand}"
                            CommandParameter="Note"
                            Content="メモ"
                            Style="{StaticResource RecentFilterButtonStyle}" />
                    <Button Margin="5,0,0,0"
                            Command="{Binding SetRecentFilterCommand}"
                            CommandParameter="Web"
                            Content="Web"
                            Style="{StaticResource RecentFilterButtonStyle}" />
                    <Button Margin="5,0,0,0"
                            Command="{Binding SetRecentFilterCommand}"
                            CommandParameter="File"
                            Content="ファイル"
                            Style="{StaticResource RecentFilterButtonStyle}" />
                    <Button Margin="5,0,0,0"
                            Command="{Binding SetRecentFilterCommand}"
                            CommandParameter="Video"
                            Content="動画"
                            Style="{StaticResource RecentFilterButtonStyle}" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <ListBox x:Name="RecentItemsList"
                             ItemsSource="{Binding RecentItems}"
                             Background="#14161D"
                             BorderThickness="0"
                             PreviewMouseRightButtonDown="RecentItemsList_PreviewMouseRightButtonDown"
                             SelectionChanged="RecentItemsList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu Background="#171B22"
                                         BorderBrush="#3A404D"
                                         BorderThickness="1"
                                         Opened="RecentItemsContextMenu_Opened"
                                         DataContext="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="プレビュー"
                                          Click="RecentPreviewMenuItem_Click" />
                                <MenuItem Header="開く"
                                          Click="RecentOpenMenuItem_Click">
                                    <MenuItem.Style>
                                        <Style TargetType="{x:Type MenuItem}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="別のブラウザーで開く"
                                          Tag="ExternalBrowserMenu">
                                    <MenuItem Header="Microsoft Edge"
                                              Tag="MicrosoftEdge"
                                              Click="RecentOpenExternalBrowserMenuItem_Click" />
                                    <MenuItem Header="Google Chrome"
                                              Tag="GoogleChrome"
                                              Click="RecentOpenExternalBrowserMenuItem_Click" />
                                    <MenuItem Header="Windowsの既定ブラウザー"
                                              Tag="WindowsDefault"
                                              Click="RecentOpenExternalBrowserMenuItem_Click" />
                                </MenuItem>
                                <MenuItem Header="追記"
                                          Click="RecentAppendMenuItem_Click"
                                          Visibility="{Binding IsNote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuItem Header="コピー"
                                          Click="RecentCopyMenuItem_Click" />
                                <MenuItem Header="Workspaceで表示"
                                          Click="RecentShowInWorkspaceMenuItem_Click"
                                          Visibility="{Binding IsWorkspaceItem, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Separator />
                                <MenuItem Header="{Binding PinMenuLabel}"
                                          Click="RecentTogglePinMenuItem_Click" />
                                <MenuItem Header="最近の一覧から削除"
                                          Click="RecentRemoveMenuItem_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="10,0,10,8"
                                        Padding="9"
                                        Background="#1A1D25"
                                        BorderBrush="#343842"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Cursor="Hand"
                                        MouseEnter="RecentItem_MouseEnter"
                                        MouseLeave="RecentItem_MouseLeave"
                                        MouseLeftButtonDown="RecentItem_MouseLeftButtonDown">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Foreground="#8AB4F8"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding CategoryLabel}" />
                                            <TextBlock DockPanel.Dock="Right"
                                                       Foreground="#FBBF24"
                                                       FontSize="11"
                                                       Text="●"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,4,0,0"
                                                   Foreground="#F9FAFB"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Row="2" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock MaxHeight="34"
                                                       VerticalAlignment="Center"
                                                       Foreground="#9CA3AF"
                                                       FontSize="10"
                                                       LineHeight="16"
                                                       Text="{Binding SecondaryText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />
                                            <Button Grid.Column="1"
                                                    Height="24"
                                                    Margin="8,0,0,0"
                                                    Padding="8,0"
                                                    Content="追記"
                                                    Click="RecentItemAppendButton_Click"
                                                    Style="{StaticResource HyperSearchButtonStyle}"
                                                    Visibility="{Binding IsNote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Margin="16"
                               VerticalAlignment="Center"
                               Foreground="#6B7280"
                               FontSize="12"
                               Text="最近使った項目はありません"
                               TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Width="620"
                Margin="16,12"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#EE2A1C1C"
                BorderBrush="#F97316"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding HasWorkspaceError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Width="88"
                        Height="28"
                        Margin="12,0,0,0"
                        Command="{Binding ReloadWorkspaceCommand}"
                        Content="再読み込み"
                        Style="{StaticResource HyperSearchButtonStyle}" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="#FED7AA"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding WorkspaceErrorText}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
        <views:QuickLookHost x:Name="WorkspaceQuickLookPreviewHost"
                             Panel.ZIndex="100" />
    </Grid>
</UserControl>
