<?xml version="1.0" encoding="utf-8"?><UserControl x:Class="TabBrowser.Views.LocalVideoPlayerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#080A0E" AllowDrop="True" DragOver="UserControl_DragOver" Drop="UserControl_Drop">
    <UserControl.Resources>
        <Style x:Key="LocalVideoControlButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#242933" />
            <Setter Property="BorderBrush" Value="#3B4350" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#080A0E" ClipToBounds="True">
        <Grid ClipToBounds="True"><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform" IsHitTestVisible="False" />
            <Grid x:Name="Surface" Background="#01000000" MouseMove="Surface_MouseMove" MouseLeave="Surface_MouseLeave" PreviewMouseLeftButtonDown="Surface_PreviewMouseLeftButtonDown" PreviewMouseDown="Surface_PreviewMouseDown" PreviewMouseUp="Surface_PreviewMouseUp" LostMouseCapture="Surface_LostMouseCapture">

        <Border x:Name="ContentTransformHud" Margin="10" Padding="7,6" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="4" IsHitTestVisible="False" Visibility="Collapsed" Background="#E612161E" BorderBrush="#8596AD" BorderThickness="1" CornerRadius="4">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="ContentTransformHudText" MinWidth="38" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#F3F4F6" FontSize="12" FontWeight="SemiBold" Text="100%" TextAlignment="Right" />
                <Border Width="72" Height="40" Background="#07090D" BorderBrush="#4B5563" BorderThickness="1">
                    <Canvas Width="70" Height="38" ClipToBounds="True">
                        <Border x:Name="ContentTransformHudViewport" Width="70" Height="38" Background="#2E8AB4F8" BorderBrush="#8AB4F8" BorderThickness="1" />
                    </Canvas>
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="ContentPanEdgeFeedback" Margin="1" Panel.ZIndex="3" IsHitTestVisible="False" Visibility="Collapsed" BorderBrush="#8AB4F8" BorderThickness="2" CornerRadius="2" />

        <Border x:Name="FixedGestureHud" Padding="14,9" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="5" IsHitTestVisible="False" Visibility="Collapsed" Background="#E612161E" BorderBrush="#8596AD" BorderThickness="1" CornerRadius="4">
            <TextBlock x:Name="FixedGestureHudText" Foreground="#F3F4F6" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" />
        </Border>

        <Border x:Name="PlaceholderPanel" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#D9151820" BorderBrush="#394150" BorderThickness="1" CornerRadius="4">
            <StackPanel MaxWidth="440">
                <TextBlock x:Name="PlaceholderTitleText" HorizontalAlignment="Center" Foreground="#F3F4F6" FontSize="13" FontWeight="SemiBold" Text="ローカル動画" />
                <TextBlock x:Name="PlaceholderMessageText" Margin="0,6,0,10" HorizontalAlignment="Center" Foreground="#AEB6C4" FontSize="11" Text="読み込みボタンを押すと再生を開始します" TextAlignment="Center" TextWrapping="Wrap" />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Width="72" Content="読み込み" Click="LoadButton_Click" Style="{StaticResource LocalVideoControlButtonStyle}" />
                    <Button x:Name="RelinkButton" Width="88" Margin="6,0,0,0" Content="参照先を変更" Click="RelinkButton_Click" Style="{StaticResource LocalVideoControlButtonStyle}" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="ControlsPanel" Margin="8" Padding="6" VerticalAlignment="Bottom" Background="#E612161E" BorderBrush="#343C49" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Slider x:Name="SeekSlider" Height="18" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" MouseMove="SeekSlider_MouseMove" MouseLeave="SeekSlider_MouseLeave" PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp" />
                <Popup x:Name="SeekPreviewPopup" Placement="Relative" PlacementTarget="{Binding ElementName=SeekSlider}" VerticalOffset="-140" AllowsTransparency="True" IsHitTestVisible="False" PopupAnimation="Fade" StaysOpen="True">
                    <Border Width="204" Padding="5" Background="#F012161E" BorderBrush="#596579" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <Border Width="192" Height="108" Background="#080A0E" BorderBrush="#343C49" BorderThickness="1">
                                <Grid>
                                    <Image x:Name="SeekPreviewImage" Width="192" Height="108" Stretch="Uniform" />
                                    <TextBlock x:Name="SeekPreviewStatusText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AEB6C4" FontSize="11" Text="プレビュー取得中" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="SeekPreviewTimeText" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="#F3F4F6" FontSize="11" FontWeight="SemiBold" Text="00:00 / 00:00" />
                        </StackPanel>
                    </Border>
                </Popup>
                <WrapPanel Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center">
                    <Button x:Name="PlayPauseButton" Width="42" Content="再生" Click="PlayPauseButton_Click" Style="{StaticResource LocalVideoControlButtonStyle}" />
                    <Button Content="-10" Click="SeekBackButton_Click" Style="{StaticResource LocalVideoControlButtonStyle}" />
                    <Button Content="+10" Click="SeekForwardButton_Click" Style="{StaticResource LocalVideoControlButtonStyle}" />
                    <TextBlock x:Name="TimeText" Width="92" Margin="6,0" VerticalAlignment="Center" Foreground="#D8DEE9" FontSize="10" Text="00:00 / 00:00" />
                    <Button x:Name="MuteButton" Width="48" Content="ミュート" Click="MuteButton_Click" Style="{StaticResource LocalVideoControlButtonStyle}" />
                    <Slider x:Name="VolumeSlider" Width="78" Margin="4,0" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" ValueChanged="VolumeSlider_ValueChanged" />
                    <ComboBox x:Name="SpeedComboBox" Width="58" Height="24" Margin="2,0" SelectionChanged="SpeedComboBox_SelectionChanged" />
                    <Button x:Name="ZoomResetButton" Width="48" Content="100%" ToolTip="動画の拡大と位置を元に戻す" Click="ZoomResetButton_Click" Style="{StaticResource LocalVideoControlButtonStyle}" />
                    <Button x:Name="LoopButton" Width="54" Content="ループ" Click="LoopButton_Click" Style="{StaticResource LocalVideoControlButtonStyle}" />
                    <Button x:Name="AbRepeatButton" Width="54" Content="A-B" Click="AbRepeatButton_Click" Style="{StaticResource LocalVideoControlButtonStyle}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AbRepeatMenu" Background="#171B22" BorderBrush="#3A404D" BorderThickness="1" Closed="AbRepeatMenu_Closed" Opened="AbRepeatMenu_Opened">
                                <MenuItem x:Name="AbRepeatStatusMenuItem" Foreground="#AEB6C4" Header="A-B未設定" IsEnabled="False" />
                                <Separator />
                                <MenuItem x:Name="AbRepeatSetStartMenuItem" Foreground="#F3F4F6" Header="A点を設定" Click="AbRepeatSetStartMenuItem_Click" />
                                <MenuItem x:Name="AbRepeatSetEndMenuItem" Foreground="#F3F4F6" Header="B点を設定" Click="AbRepeatSetEndMenuItem_Click" />
                                <MenuItem x:Name="AbRepeatToggleMenuItem" Foreground="#F3F4F6" Header="A-B再生を開始" Click="AbRepeatToggleMenuItem_Click" />
                                <MenuItem x:Name="AbRepeatClearMenuItem" Foreground="#F3F4F6" Header="A-B範囲を消去" Click="AbRepeatClearMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Width="48" Content="全画面" Click="FullScreenButton_Click" Style="{StaticResource LocalVideoControlButtonStyle}" />
                    <Button Width="48" Content="再読込" Click="ReloadButton_Click" Style="{StaticResource LocalVideoControlButtonStyle}" />
                </WrapPanel>
            </Grid>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
