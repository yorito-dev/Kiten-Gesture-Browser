<UserControl x:Class="TabBrowser.Views.QuickLookHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="QuickLookHost_PreviewKeyDown"
             Visibility="Collapsed">
    <Grid x:Name="HostRoot"
          AllowDrop="True"
          Background="{x:Null}"
          DragOver="HostRoot_DragOver"
          Drop="HostRoot_Drop">
        <Border x:Name="PreviewPanel"
                Margin="28,42"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                MaxWidth="760"
                MaxHeight="580"
                Background="#F2101319"
                BorderBrush="#526173"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PaneDragHeader"
                            Padding="0,0,8,0"
                            Background="Transparent"
                            Cursor="SizeAll"
                            LostMouseCapture="PaneDragHeader_LostMouseCapture"
                            PreviewMouseLeftButtonDown="PaneDragHeader_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="PaneDragHeader_PreviewMouseLeftButtonUp"
                            PreviewMouseMove="PaneDragHeader_PreviewMouseMove"
                            ToolTip="右端または下端へドラッグしてペインを移動">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       Foreground="#F8FAFC"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SubtitleText"
                                       Margin="0,2,0,0"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="4,0,6,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button x:Name="FloatingModeButton"
                                Width="42"
                                Height="24"
                                Padding="0"
                                Content="浮動"
                                Click="FloatingModeButton_Click"
                                ToolTip="フローティング表示" />
                        <Button x:Name="RightPaneModeButton"
                                Width="30"
                                Height="24"
                                Margin="2,0,0,0"
                                Padding="0"
                                Content="右"
                                Click="RightPaneModeButton_Click"
                                ToolTip="右ペイン表示" />
                        <Button x:Name="BottomPaneModeButton"
                                Width="30"
                                Height="24"
                                Margin="2,0,0,0"
                                Padding="0"
                                Content="下"
                                Click="BottomPaneModeButton_Click"
                                ToolTip="下ペイン表示" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Width="30"
                            Height="26"
                            Content="×"
                            Click="CloseButton_Click"
                            ToolTip="QuickLookを閉じる"
                            Foreground="#F8FAFC"
                            Background="#242A34"
                            BorderBrush="#4B5563" />
                </Grid>

                <Border Grid.Row="1"
                        Margin="10,0"
                        Background="#0B0E13"
                        BorderBrush="#29313C"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="TextOptionsPanel"
                                Grid.Row="0"
                                Padding="8,3"
                                Background="#11161D"
                                BorderBrush="#29313C"
                                BorderThickness="0,0,0,1"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,7,0"
                                           VerticalAlignment="Center"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           Text="文字" />
                                <Button x:Name="TextSmallerButton"
                                        Width="30"
                                        Height="24"
                                        Padding="0"
                                        Content="A-"
                                        Click="TextSmallerButton_Click"
                                        ToolTip="文字を小さく" />
                                <TextBlock x:Name="TextFontSizeText"
                                           Width="30"
                                           VerticalAlignment="Center"
                                           Foreground="#E5E7EB"
                                           FontSize="11"
                                           TextAlignment="Center" />
                                <Button x:Name="TextLargerButton"
                                        Width="30"
                                        Height="24"
                                        Padding="0"
                                        Content="A+"
                                        Click="TextLargerButton_Click"
                                        ToolTip="文字を大きく" />
                                <Button x:Name="TextWrapButton"
                                        Height="24"
                                        Margin="5,0,0,0"
                                        Padding="8,0"
                                        Content="折返し"
                                        Click="TextWrapButton_Click"
                                        ToolTip="長い行の折り返しを切り替え" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <TextBlock x:Name="StateText"
                                       Margin="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#CBD5E1"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />

                            <Image x:Name="PreviewImage"
                                   Margin="12"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed" />

                            <TextBox x:Name="PreviewText"
                                     Margin="10"
                                     Padding="12"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     Background="#0B0E13"
                                     BorderThickness="0"
                                     CaretBrush="#F8FAFC"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     Foreground="#E5E7EB"
                                     HorizontalScrollBarVisibility="Disabled"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="True"
                                     SelectionBrush="#315A82"
                                     SelectionOpacity="1"
                                     TextBlock.LineHeight="20"
                                     TextBlock.LineStackingStrategy="BlockLineHeight"
                                     TextWrapping="WrapWithOverflow"
                                     VerticalScrollBarVisibility="Auto"
                                     Visibility="Collapsed" />

                            <ScrollViewer x:Name="InformationPanel"
                                          Padding="24"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="Collapsed">
                                <StackPanel>
                                    <Image x:Name="InformationIcon"
                                           Width="64"
                                           Height="64"
                                           Margin="0,0,0,16"
                                           HorizontalAlignment="Left"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock x:Name="InformationText"
                                               Foreground="#E5E7EB"
                                               FontSize="13"
                                               LineHeight="20"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer x:Name="WebSummaryPanel"
                                          Padding="16"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="Collapsed">
                                <StackPanel>
                                    <Viewbox MaxHeight="315"
                                             HorizontalAlignment="Center"
                                             Stretch="Uniform">
                                        <Border Width="560"
                                                Height="315"
                                                Background="#11161D"
                                                BorderBrush="#34404D"
                                                BorderThickness="1"
                                                ClipToBounds="True"
                                                CornerRadius="5">
                                            <Grid>
                                                <Image x:Name="WebSummaryImage"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="Collapsed" />
                                                <StackPanel x:Name="WebSummaryImageFallbackPanel"
                                                            Margin="16"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                <Border Width="60"
                                                        Height="60"
                                                        HorizontalAlignment="Center"
                                                        Background="#1A222C"
                                                        BorderBrush="#3B4755"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                    <Grid>
                                                        <Image x:Name="WebSummaryHeroFavicon"
                                                               Width="40"
                                                               Height="40"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="Collapsed" />
                                                        <TextBlock x:Name="WebSummaryHeroFaviconFallbackText"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#8AB4F8"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Text="WEB" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock x:Name="WebSummaryImageFallbackText"
                                                           Margin="0,10,0,0"
                                                           Foreground="#77869A"
                                                           FontSize="11"
                                                           Text="保存済みサムネイルはありません"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Viewbox>

                                    <Grid Margin="2,13,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32"
                                                Height="32"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="#1A222C"
                                                BorderBrush="#3B4755"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <Image x:Name="WebSummaryFavicon"
                                                       Width="22"
                                                       Height="22"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="Collapsed" />
                                                <TextBlock x:Name="WebSummaryFaviconFallbackText"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#8AB4F8"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="W" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="WebSummaryTitleText"
                                                       MaxHeight="66"
                                                       Foreground="#F8FAFC"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       LineHeight="22"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="WebSummaryDomainText"
                                                       Margin="0,5,0,0"
                                                       Foreground="#8AB4F8"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="2,10,2,0"
                                            Padding="8,6"
                                            Background="#11161D"
                                            BorderBrush="#29313C"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <TextBlock x:Name="WebSummaryUrlText"
                                                   MaxHeight="50"
                                                   Foreground="#9EADBF"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   LineHeight="16"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <Border x:Name="WebSummaryDetailPanel"
                                            Margin="2,10,2,2"
                                            Padding="10,8"
                                            Background="#11161D"
                                            BorderBrush="#34404D"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Foreground="#7F8EA3"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Text="ページ概要" />
                                            <TextBlock x:Name="WebSummaryDetailText"
                                                       MaxHeight="112"
                                                       Margin="0,5,0,0"
                                                       Foreground="#D6DEE8"
                                                       FontSize="12"
                                                       LineHeight="18"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <ContentControl x:Name="InteractiveContent"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PreviousButton"
                                Width="30"
                                Height="26"
                                Margin="0,0,4,0"
                                Content="←"
                                Click="PreviousButton_Click"
                                ToolTip="前の項目" />
                        <Button x:Name="NextButton"
                                Width="30"
                                Height="26"
                                Content="→"
                                Click="NextButton_Click"
                                ToolTip="次の項目" />
                    </StackPanel>
                    <TextBlock x:Name="LimitText"
                               Grid.Column="1"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               Foreground="#FBBF24"
                               FontSize="10"
                               Text="上限まで表示しています"
                               Visibility="Collapsed" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ItemsControl x:Name="AdditionalActionsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="26"
                                            Margin="0,0,5,0"
                                            Padding="9,0"
                                            Content="{Binding Label}"
                                            Click="QuickLookActionButton_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="CopyButton"
                                Height="26"
                                Margin="0,0,5,0"
                                Padding="9,0"
                                Content="コピー"
                                Click="CopyButton_Click"
                                Visibility="Collapsed" />
                        <Button x:Name="ShowInFolderButton"
                                Height="26"
                                Margin="0,0,5,0"
                                Padding="9,0"
                                Content="場所を表示"
                                Click="ShowInFolderButton_Click" />
                        <Button x:Name="OpenButton"
                                Height="26"
                                Padding="9,0"
                                Content="開く"
                                Click="OpenButton_Click" />
                    </StackPanel>
                </Grid>

                <Thumb x:Name="RightResizeThumb"
                       Grid.RowSpan="3"
                       Width="6"
                       HorizontalAlignment="Left"
                       Cursor="SizeWE"
                       DragCompleted="PaneResizeThumb_DragCompleted"
                       DragDelta="RightResizeThumb_DragDelta"
                       Opacity="0"
                       Panel.ZIndex="20"
                       Visibility="Collapsed" />
                <Thumb x:Name="BottomResizeThumb"
                       Grid.RowSpan="3"
                       Height="6"
                       VerticalAlignment="Top"
                       Cursor="SizeNS"
                       DragCompleted="PaneResizeThumb_DragCompleted"
                       DragDelta="BottomResizeThumb_DragDelta"
                       Opacity="0"
                       Panel.ZIndex="20"
                       Visibility="Collapsed" />
                <Thumb x:Name="FloatingResizeThumb"
                       Grid.RowSpan="3"
                       Width="14"
                       Height="14"
                       Margin="0,0,3,3"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNWSE"
                       DragCompleted="PaneResizeThumb_DragCompleted"
                       DragDelta="FloatingResizeThumb_DragDelta"
                       Panel.ZIndex="20"
                       ToolTip="サイズ変更"
                       Visibility="Collapsed">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="#334155"
                                    BorderBrush="#60A5FA"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>
    </Grid>
</UserControl>
