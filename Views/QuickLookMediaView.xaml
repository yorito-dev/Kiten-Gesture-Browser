<?xml version="1.0" encoding="utf-8"?><UserControl x:Class="TabBrowser.Views.QuickLookMediaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#080A0E">
    <UserControl.Resources>
        <Style x:Key="MediaButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="25" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#242933" />
            <Setter Property="BorderBrush" Value="#3B4350" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#080A0E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ClipToBounds="True" Grid.Row="0"><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform" IsHitTestVisible="False" />
            <Grid Background="#01000000" ClipToBounds="True">

                <Border x:Name="StatePanel" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#E6151820" BorderBrush="#394150" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="MediaTitleText" MaxWidth="420" HorizontalAlignment="Center" Foreground="#F3F4F6" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StateText" Margin="0,6,0,0" MaxWidth="420" HorizontalAlignment="Center" Foreground="#AEB6C4" FontSize="11" Text="再生を押すと読み込みを開始します" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="ControlsPanel" Grid.Row="1" Margin="8" Padding="7" Background="#E612161E" BorderBrush="#343C49" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Slider x:Name="SeekSlider" Height="18" Minimum="0" Maximum="100" PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp" />
                        <WrapPanel Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center">
                            <Button x:Name="PlayPauseButton" Content="再生" Click="PlayPauseButton_Click" Style="{StaticResource MediaButtonStyle}" />
                            <Button Content="-10秒" Click="SeekBackButton_Click" Style="{StaticResource MediaButtonStyle}" />
                            <Button Content="+10秒" Click="SeekForwardButton_Click" Style="{StaticResource MediaButtonStyle}" />
                            <TextBlock x:Name="TimeText" Width="104" Margin="5,0" VerticalAlignment="Center" Foreground="#D8DEE9" FontSize="10" Text="00:00 / 00:00" />
                            <Button x:Name="MuteButton" Content="ミュート" Click="MuteButton_Click" Style="{StaticResource MediaButtonStyle}" />
                            <Slider x:Name="VolumeSlider" Width="90" Margin="4,0" Minimum="0" Maximum="100" ValueChanged="VolumeSlider_ValueChanged" />
                        </WrapPanel>
                    </Grid>
        </Border>
    </Grid>
</UserControl>
