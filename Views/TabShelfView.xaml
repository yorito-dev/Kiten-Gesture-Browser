<UserControl x:Class="TabBrowser.Views.TabShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#151820"
             MouseLeave="TabShelfView_MouseLeave">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ShelfButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#23262D" />
            <Setter Property="BorderBrush" Value="#343842" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="ShelfCloseButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ShelfButtonStyle}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Background" Value="#1A1E25" />
            <Setter Property="BorderBrush" Value="#343842" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FCA5A5" />
                    <Setter Property="Background" Value="#3A2025" />
                    <Setter Property="BorderBrush" Value="#7F1D1D" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#51242A" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#151820">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,10,12,6"
                BorderBrush="#262A33"
                BorderThickness="0,1,0,1">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Foreground="#9CA3AF"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="TAB SHELF" />
                    <Button DockPanel.Dock="Right"
                            Width="34"
                            Height="24"
                            Margin="0"
                            Padding="0"
                            Command="{Binding RefreshTabsCommand}"
                            Content="&#x66F4;&#x65B0;"
                            Style="{StaticResource ShelfButtonStyle}"
                            ToolTip="&#x30BF;&#x30D6;&#x4E00;&#x89A7;&#x3092;&#x66F4;&#x65B0;" />
                    <TextBlock DockPanel.Dock="Right"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#FBBF24"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="&#x4FDD;&#x5B58;&#x4E2D;"
                               Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </DockPanel>
                <WrapPanel Margin="0,8,0,0">
                    <Button Command="{Binding SaveCurrentTabCommand}"
                            Content="&#x73FE;&#x5728;"
                            Style="{StaticResource ShelfButtonStyle}"
                            ToolTip="&#x73FE;&#x5728;&#x306E;&#x30BF;&#x30D6;&#x3092;&#x4FDD;&#x5B58;" />
                    <Button Command="{Binding SaveSelectedTabsCommand}"
                            Content="&#x9078;&#x629E;"
                            Style="{StaticResource ShelfButtonStyle}"
                            ToolTip="&#x9078;&#x629E;&#x3057;&#x305F;&#x30BF;&#x30D6;&#x3092;&#x4FDD;&#x5B58;" />
                    <Button Command="{Binding SaveAllTabsCommand}"
                            Content="&#x5168;&#x30BF;&#x30D6;"
                            Style="{StaticResource ShelfButtonStyle}"
                            ToolTip="&#x5168;&#x30BF;&#x30D6;&#x3092;&#x4FDD;&#x5B58;" />
                    <Button Command="{Binding SaveAndCloseCurrentTabCommand}"
                            Content="&#x4FDD;&#x5B58;+&#x9589;"
                            Style="{StaticResource ShelfButtonStyle}"
                            ToolTip="&#x4FDD;&#x5B58;&#x5F8C;&#x306B;&#x73FE;&#x5728;&#x306E;&#x30BF;&#x30D6;&#x3092;&#x9589;&#x3058;&#x308B;" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <ListBox x:Name="OpenTabsList"
                 Grid.Row="1"
                 AllowDrop="True"
                 ItemsSource="{Binding OpenTabsView}"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#F3F4F6"
                 PreviewMouseLeftButtonDown="OpenTabsList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="OpenTabsList_PreviewMouseMove"
                 PreviewMouseRightButtonDown="OpenTabsList_PreviewMouseRightButtonDown"
                 DragOver="OpenTabsList_DragOver"
                 Drop="OpenTabsList_Drop"
                 PreviewKeyDown="OpenTabsList_PreviewKeyDown"
                 SelectionChanged="OpenTabsList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ContextMenu>
                <ContextMenu Background="#171B22"
                             BorderBrush="#3A404D"
                             BorderThickness="1">
                    <MenuItem Header="プレビュー"
                              Click="PreviewMenuItem_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Padding="10,8,10,5"
                                    AllowDrop="True"
                                    Background="#151820"
                                    BorderBrush="#262A33"
                                    BorderThickness="0,1,0,1"
                                    DragOver="OpenTabsGroupHeader_DragOver"
                                    Drop="OpenTabsGroupHeader_Drop">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left"
                                               VerticalAlignment="Center"
                                               Foreground="#D1D5DB"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="{Binding Name}" />
                                    <TextBlock DockPanel.Dock="Right"
                                               VerticalAlignment="Center"
                                               Foreground="#6B7280"
                                               FontSize="10"
                                               Text="{Binding ItemCount, StringFormat={}{0} 件}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="#262A33" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1D2530" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid x:Name="TabShelfRow"
                          Margin="8,7"
                          MouseEnter="TabShelfRow_MouseEnter"
                          MouseLeave="TabShelfRow_MouseLeave">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>

                        <Popup PlacementTarget="{Binding ElementName=TabShelfRow}"
                               Placement="Right"
                               HorizontalOffset="8"
                               VerticalOffset="-8"
                               AllowsTransparency="True"
                               PopupAnimation="None"
                               StaysOpen="True"
                               IsHitTestVisible="False">
                            <Border Width="304"
                                    Padding="8"
                                    Background="#11141A"
                                    BorderBrush="#3A404D"
                                    BorderThickness="1">
                                <StackPanel>
                                    <Border Width="286"
                                            Height="161"
                                            Background="#0B0D11"
                                            BorderBrush="#272C36"
                                            BorderThickness="1">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="LowQuality">
                                                <Image.Style>
                                                    <Style TargetType="{x:Type Image}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#9CA3AF"
                                                       FontSize="12"
                                                       Text="{Binding ThumbnailPlaceholderText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="#F3F4F6"
                                               FontSize="12"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="#9CA3AF"
                                               FontSize="10"
                                               Text="{Binding Url}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <CheckBox Grid.Column="0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Grid.Column="1"
                              Width="20"
                              Height="20"
                              VerticalAlignment="Top">
                            <Border Background="#20242E"
                                    BorderBrush="#3A404D"
                                    BorderThickness="1" />
                            <Image Source="{Binding Favicon}"
                                   Stretch="Uniform">
                                <Image.Style>
                                    <Style TargetType="{x:Type Image}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFavicon}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#D1D5DB"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="{Binding DisplayIndex}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFavicon}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Grid.Column="2"
                                    Margin="7,0,0,0">
                            <TextBlock Foreground="#F3F4F6"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#9CA3AF"
                                       FontSize="10"
                                       Text="{Binding SecondaryText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="3"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="閉じる"
                                Command="{Binding DataContext.CloseItemCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                Content="&#x00D7;"
                                Style="{StaticResource ShelfCloseButtonStyle}"
                                ToolTip="閉じる" />

                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1"
                   Margin="12"
                   VerticalAlignment="Center"
                   Foreground="#6B7280"
                   FontSize="12"
                   Text="&#x4FDD;&#x5B58;&#x3067;&#x304D;&#x308B;&#x30BF;&#x30D6;&#x304C;&#x3042;&#x308A;&#x307E;&#x305B;&#x3093;"
                   TextAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasOpenTabs}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
