                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="TextAlignment" Value="Center" />
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="2"
                                                          Color="#000000"
                                                          Opacity="0.85"
                                                          ShadowDepth="1" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,2,2,0"
                                        Padding="4,1"
                                        Background="#CC0F766E"
                                        CornerRadius="3"
                                        Visibility="{Binding IsRecent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Foreground="#ECFEFF"
                                               FontSize="8"
                                               FontWeight="Bold"
                                               Text="NEW" />
                                </Border>
                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="1"
                                        Padding="4,1"
                                        Background="#E6B91C1C"
                                        CornerRadius="3"
                                        Visibility="{Binding IsShellItemMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Foreground="#FFFFFF"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Text="!" />
                                </Border>
                                </Grid>
                                <Border x:Name="NoteBodyCard"
                                        Grid.RowSpan="2"
                                        Padding="9,7"
                                        Background="#F2181B22"
                                        CornerRadius="4"
                                        ClipToBounds="True"
                                        Panel.ZIndex="4">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Stretch"
                                               VerticalAlignment="Top"
                                               Foreground="#F8FAFC"
                                               FontSize="{Binding NoteFontSize}"
                                               FontWeight="Normal"
                                               LineHeight="{Binding NoteLineHeight}"
                                               Text="{Binding CardPrimaryText}"
                                               TextAlignment="Left"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <Border x:Name="RangeSelectionRectangle"
                Width="0"
                Height="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Background="#334B8DFF"
                BorderBrush="#FF60A5FA"
                BorderThickness="1"
                CornerRadius="2" />

        <Border x:Name="RangeSelectionModeFrame"
                Margin="3"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Background="#0D3B82F6"
                BorderBrush="#9960A5FA"
                BorderThickness="2"
                CornerRadius="4" />

        <Border x:Name="RangeSelectionModeIndicator"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Padding="8,4"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Background="#F21B2432"
                BorderBrush="#FF60A5FA"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <Border Margin="0,0,7,0"
                        Padding="5,1"
                        Background="#FF2563EB"
                        CornerRadius="3">
                    <TextBlock Foreground="White"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="Ctrl" />
                </Border>
                <TextBlock VerticalAlignment="Center"
                           Foreground="#EFF6FF"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="範囲選択" />
            </StackPanel>
        </Border>

        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Foreground="#6B7280"
                   FontSize="14"
                   Text="右クリックでメモを追加できます">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12"
                Padding="7"
                Background="#CC111827"
                BorderBrush="#4B5563"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <Button Content="-"
                        Click="ZoomOutButton_Click"
                        Style="{StaticResource WorkspaceUtilityButtonStyle}"
                        ToolTip="縮小" />
                <Button Content="+"
                        Click="ZoomInButton_Click"
                        Style="{StaticResource WorkspaceUtilityButtonStyle}"
                        ToolTip="拡大" />
                <Button x:Name="ResetZoomButton"
                        Content="100%"
                        Click="ResetZoomButton_Click"
                        Style="{StaticResource WorkspaceUtilityButtonStyle}"
                        ToolTip="ズームを戻す" />
                <Button x:Name="ArrangeMenuButton"
                        Content="{Binding ArrangeMenuText}"
                        Click="ArrangeMenuButton_Click"
                        PreviewMouseLeftButtonDown="MenuButton_PreviewMouseLeftButtonDown"
                        Style="{StaticResource WorkspaceUtilityButtonStyle}"
                        ToolTip="カードの整列方法を選択">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Mouse.PreviewMouseDownOutsideCapturedElement="ButtonContextMenu_MouseDownOutsideCapturedElement">
                            <MenuItem Header="{Binding ArrangeSelectionMenuText}"
                                      IsEnabled="{Binding CanArrangeSelection}">
                                <MenuItem Header="コンパクト配置" Tag="Selection|CurrentPosition" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="名前順" Tag="Selection|Title" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="種類順" Tag="Selection|Type" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="サイト／場所順" Tag="Selection|Site" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="追加順" Tag="Selection|CreatedAt" Click="ArrangeMenuItem_Click" />
                            </MenuItem>
                            <MenuItem Header="現在場所の全カードを整列">
                                <MenuItem Header="コンパクト配置" Tag="All|CurrentPosition" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="名前順" Tag="All|Title" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="種類順" Tag="All|Type" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="サイト／場所順" Tag="All|Site" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="追加順" Tag="All|CreatedAt" Click="ArrangeMenuItem_Click" />
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="元に戻す"
                        Click="RestoreArrangeButton_Click"
                        IsEnabled="{Binding HasArrangeSnapshot}"
                        Style="{StaticResource WorkspaceUtilityButtonStyle}"
                        ToolTip="最初の整列前の位置へ戻す" />
                <Button Content="画面内"
                        Click="BringSelectedIntoViewButton_Click"
                        Style="{StaticResource WorkspaceUtilityButtonStyle}"
                        ToolTip="選択カードを画面内へ戻す" />
                <Button Content="最近"
                        Click="JumpToRecentButton_Click"
                        Style="{StaticResource WorkspaceUtilityButtonStyle}"
                        ToolTip="最近追加したカードへ移動" />
                <Button Content="地図"
                        Margin="0"
                        Click="ToggleMiniMapButton_Click"
                        Style="{StaticResource WorkspaceUtilityButtonStyle}"
                        ToolTip="ミニマップ表示を切り替え" />
            </StackPanel>
        </Border>

        <Border x:Name="MiniMapPanel"
                Width="198"
                Height="138"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="12"
                Padding="8"
                Background="#DD111827"
                BorderBrush="#4B5563"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Foreground="#D1D5DB"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Text="MAP" />
                <Canvas x:Name="MiniMapCanvas"
                        Width="180"
                        Height="120"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#1F2937"
                        Cursor="Hand"
                        MouseLeftButtonDown="MiniMapCanvas_MouseLeftButtonDown"
                        MouseLeftButtonUp="MiniMapCanvas_MouseLeftButtonUp"
                        MouseMove="MiniMapCanvas_MouseMove"
                        LostMouseCapture="MiniMapCanvas_LostMouseCapture">
                    <ItemsControl Width="4800"
                                  Height="3200"
                                  ItemsSource="{Binding Items}"
                                  IsHitTestVisible="False">
                        <ItemsControl.RenderTransform>
                            <ScaleTransform ScaleX="0.0375"
                                            ScaleY="0.0375" />
                        </ItemsControl.RenderTransform>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        Background="#60A5FA"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Rectangle x:Name="MiniMapViewportRect"
                               Stroke="#FBBF24"
                               StrokeThickness="2"
                               Fill="#22FBBF24"
                               IsHitTestVisible="False" />
                </Canvas>
            </Grid>
        </Border>
    </Grid>
    <views:QuickLookHost x:Name="QuickLookPreviewHost"
                         Panel.ZIndex="100" />
    </Grid>
</UserControl>
