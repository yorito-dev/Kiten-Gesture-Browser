<UserControl x:Class="TabBrowser.Views.WorkspaceCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TabBrowser.Views"
             xmlns:workspaceModels="clr-namespace:TabBrowser.Models.Workspaces"
             MinWidth="320"
             MinHeight="240"
             Focusable="True"
             PreviewKeyDown="WorkspaceCanvasView_PreviewKeyDown"
             PreviewKeyUp="WorkspaceCanvasView_PreviewKeyUp"
             Background="#0F1115">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="WorkspaceUtilityButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#CC1B1F28" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <DrawingBrush x:Key="WorkspaceMinorGridBrush"
                      TileMode="Tile"
                      Viewbox="0,0,24,24"
                      ViewboxUnits="Absolute"
                      Viewport="0,0,24,24"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M 0.5,0 L 0.5,24 M 0,0.5 L 24,0.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#26313D"
                             Thickness="0.7" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="WorkspaceMajorGridBrush"
                      TileMode="Tile"
                      Viewbox="0,0,120,120"
                      ViewboxUnits="Absolute"
                      Viewport="0,0,120,120"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M 0.5,0 L 0.5,120 M 0,0.5 L 120,0.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#3A4656"
                             Thickness="1.1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="WorkspaceCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#00181B22" />
            <Setter Property="BorderBrush" Value="#003A404D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNote}" Value="True">
                    <Setter Property="BorderBrush" Value="#526174" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33202A35" />
                    <Setter Property="BorderBrush" Value="#667B8495" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF" />
                    <Setter Property="BorderBrush" Value="#FFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragGuideVisible}" Value="True">
                    <Setter Property="Background" Value="#11181B22" />
                    <Setter Property="BorderBrush" Value="#B0A7B2C3" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                    <Setter Property="Background" Value="#332B2410" />
                    <Setter Property="BorderBrush" Value="#FBBF24" />
                    <Setter Property="BorderThickness" Value="2.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WorkspaceAccentStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="3" />
            <Setter Property="Background" Value="#64748B" />
            <Setter Property="CornerRadius" Value="5,0,0,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static workspaceModels:WorkspaceItemType.Bookmark}">
                    <Setter Property="Background" Value="#60A5FA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static workspaceModels:WorkspaceItemType.Folder}">
                    <Setter Property="Background" Value="#FACC15" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static workspaceModels:WorkspaceItemType.SessionGroup}">
                    <Setter Property="Background" Value="#4ADE80" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static workspaceModels:WorkspaceItemType.Note}">
                    <Setter Property="Background" Value="#D8B4FE" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WorkspaceTypeBadgeStyle" TargetType="{x:Type Border}">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="#334155" />
            <Setter Property="CornerRadius" Value="3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static workspaceModels:WorkspaceItemType.Bookmark}">
                    <Setter Property="Background" Value="#1D4ED8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static workspaceModels:WorkspaceItemType.Folder}">
                    <Setter Property="Background" Value="#A16207" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static workspaceModels:WorkspaceItemType.SessionGroup}">
                    <Setter Property="Background" Value="#15803D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static workspaceModels:WorkspaceItemType.Note}">
                    <Setter Property="Background" Value="#7E22CE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static workspaceModels:WorkspaceItemType.ShellItem}">
                    <Setter Property="Background" Value="#0369A1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShellItemMenuStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static workspaceModels:WorkspaceItemType.ShellItem}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShellDirectoryMenuStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsShellDirectory}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShellVideoMenuStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsShellVideo}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="WorkspaceQuickLookLayoutRoot"
          Background="#0F1115">
    <Grid x:Name="CanvasViewport"
          AllowDrop="True"
          Background="#0F1115"
          ClipToBounds="True"
          DragOver="CanvasItemsControl_DragOver"
          Drop="CanvasItemsControl_Drop"
          PreviewMouseLeftButtonDown="CanvasViewport_PreviewMouseLeftButtonDown"
          PreviewMouseLeftButtonUp="CanvasViewport_PreviewMouseLeftButtonUp"
          PreviewMouseMove="CanvasViewport_PreviewMouseMove"
          MouseEnter="CanvasViewport_MouseEnter"
          MouseLeave="CanvasViewport_MouseLeave"
          LostMouseCapture="CanvasViewport_LostMouseCapture"
          PreviewMouseRightButtonDown="CanvasItemsControl_PreviewMouseRightButtonDown">
        <Grid.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="フォルダを追加"
                          Click="AddFolderMenuItem_Click" />
                <MenuItem Header="メモを追加"
                          Click="AddNoteMenuItem_Click" />
                <Separator />
                <MenuItem Header="直前のファイル操作を元に戻す"
                          IsEnabled="{Binding CanUndoShellOperation}"
                          Click="UndoShellOperationMenuItem_Click" />
                <MenuItem Header="ごみ箱を開く"
                          Click="OpenRecycleBinMenuItem_Click" />
                <Separator />
                <MenuItem Header="整列">
                    <MenuItem Header="{Binding ArrangeSelectionMenuText}"
                              IsEnabled="{Binding CanArrangeSelection}">
                        <MenuItem Header="コンパクト配置" Tag="Selection|CurrentPosition" Click="ArrangeMenuItem_Click" />
                        <MenuItem Header="名前順" Tag="Selection|Title" Click="ArrangeMenuItem_Click" />
                        <MenuItem Header="種類順" Tag="Selection|Type" Click="ArrangeMenuItem_Click" />
                        <MenuItem Header="サイト／場所順" Tag="Selection|Site" Click="ArrangeMenuItem_Click" />
                        <MenuItem Header="追加順" Tag="Selection|CreatedAt" Click="ArrangeMenuItem_Click" />
                    </MenuItem>
                    <MenuItem Header="現在場所の全カードを整列">
                        <MenuItem Header="コンパクト配置" Tag="All|CurrentPosition" Click="ArrangeMenuItem_Click" />
                        <MenuItem Header="名前順" Tag="All|Title" Click="ArrangeMenuItem_Click" />
                        <MenuItem Header="種類順" Tag="All|Type" Click="ArrangeMenuItem_Click" />
                        <MenuItem Header="サイト／場所順" Tag="All|Site" Click="ArrangeMenuItem_Click" />
                        <MenuItem Header="追加順" Tag="All|CreatedAt" Click="ArrangeMenuItem_Click" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="整列前の位置へ戻す"
                          IsEnabled="{Binding HasArrangeSnapshot}"
                          Click="RestoreArrangeMenuItem_Click" />
            </ContextMenu>
        </Grid.ContextMenu>
        <Canvas x:Name="CanvasGridLayer"
                Width="4800"
                Height="3200"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CanvasGridZoomTransform" />
                    <TranslateTransform x:Name="CanvasGridPanTransform" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Rectangle Width="4800"
                       Height="3200"
                       Fill="{StaticResource WorkspaceMinorGridBrush}"
                       Opacity="0.55" />
            <Rectangle Width="4800"
                       Height="3200"
                       Fill="{StaticResource WorkspaceMajorGridBrush}"
                       Opacity="0.75" />
        </Canvas>
        <Thumb x:Name="CanvasPanThumb"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               AllowDrop="True"
               Cursor="SizeAll"
               DragOver="CanvasItemsControl_DragOver"
               Drop="CanvasItemsControl_Drop"
               Opacity="0"
               PreviewMouseLeftButtonDown="CanvasPanThumb_PreviewMouseLeftButtonDown"
               PreviewMouseLeftButtonUp="CanvasPanThumb_PreviewMouseLeftButtonUp"
               PreviewMouseMove="CanvasPanThumb_PreviewMouseMove"
               LostMouseCapture="CanvasPanThumb_LostMouseCapture"
               PreviewMouseRightButtonDown="CanvasItemsControl_PreviewMouseRightButtonDown" />
        <Canvas x:Name="CanvasItemsHost"
                Width="4800"
                Height="3200"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{x:Null}">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CanvasZoomTransform" />
                    <TranslateTransform x:Name="CanvasPanTransform" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <ItemsControl x:Name="CanvasItemsControl"
                          Width="4800"
                          Height="3200"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          AllowDrop="True"
                          Background="{x:Null}"
                          DragOver="CanvasItemsControl_DragOver"
                          Drop="CanvasItemsControl_Drop"
                          PreviewMouseRightButtonDown="CanvasItemsControl_PreviewMouseRightButtonDown">
                <ItemsControl.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="フォルダを追加"
                                  Click="AddFolderMenuItem_Click" />
                        <MenuItem Header="メモを追加"
                                  Click="AddNoteMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="整列">
                            <MenuItem Header="{Binding ArrangeSelectionMenuText}"
                                      IsEnabled="{Binding CanArrangeSelection}">
                                <MenuItem Header="コンパクト配置" Tag="Selection|CurrentPosition" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="名前順" Tag="Selection|Title" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="種類順" Tag="Selection|Type" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="サイト／場所順" Tag="Selection|Site" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="追加順" Tag="Selection|CreatedAt" Click="ArrangeMenuItem_Click" />
                            </MenuItem>
                            <MenuItem Header="現在場所の全カードを整列">
                                <MenuItem Header="コンパクト配置" Tag="All|CurrentPosition" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="名前順" Tag="All|Title" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="種類順" Tag="All|Type" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="サイト／場所順" Tag="All|Site" Click="ArrangeMenuItem_Click" />
                                <MenuItem Header="追加順" Tag="All|CreatedAt" Click="ArrangeMenuItem_Click" />
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="整列前の位置へ戻す"
                                  IsEnabled="{Binding HasArrangeSnapshot}"
                                  Click="RestoreArrangeMenuItem_Click" />
                    </ContextMenu>
                </ItemsControl.ContextMenu>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Background="{x:Null}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ContentPresenter}">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        <!-- Canvas全体やドラッグ用Windowではなく、各カードだけの描画を再利用する。 -->
                        <Setter Property="CacheMode">
                            <Setter.Value>
                                <BitmapCache RenderAtScale="{Binding CardCacheRenderScale, RelativeSource={RelativeSource AncestorType={x:Type views:WorkspaceCanvasView}}}" />
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding Width}"
                                Height="{Binding Height}"
                                AllowDrop="True"
                                Style="{StaticResource WorkspaceCardStyle}"
                                DragOver="Item_DragOver"
                                 Drop="Item_Drop"
                                 PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="Item_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="Item_PreviewMouseLeftButtonUp"
                                 PreviewMouseWheel="Item_PreviewMouseWheel"
                                 ToolTipOpening="Item_ToolTipOpening"
                                 ToolTipService.InitialShowDelay="350"
                                 ToolTipService.ShowDuration="60000"
                                 PreviewMouseRightButtonDown="Item_PreviewMouseRightButtonDown">
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             Opened="WorkspaceItemContextMenu_Opened">
                                    <MenuItem Header="開く"
                                              Click="OpenMenuItem_Click" />
                                    <MenuItem Header="別のブラウザーで開く"
                                              Tag="ExternalBrowserMenu">
                                        <MenuItem Header="Microsoft Edge"
                                                  Tag="MicrosoftEdge"
                                                  Click="OpenExternalBrowserMenuItem_Click" />
                                        <MenuItem Header="Google Chrome"
                                                  Tag="GoogleChrome"
                                                  Click="OpenExternalBrowserMenuItem_Click" />
                                        <MenuItem Header="Windowsの既定ブラウザー"
                                                  Tag="WindowsDefault"
                                                  Click="OpenExternalBrowserMenuItem_Click" />
                                    </MenuItem>
                                    <MenuItem Header="プレビュー"
                                              Click="QuickLookMenuItem_Click" />
                                    <MenuItem Header="新しいウィンドウで開く"
                                              Click="OpenInNewWindowMenuItem_Click">
                                        <MenuItem.Style>
                                            <Style TargetType="{x:Type MenuItem}">
                                                <Setter Property="IsEnabled" Value="True" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}"
                                                                 Value="{x:Static workspaceModels:WorkspaceItemType.Folder}">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}"
                                                                 Value="{x:Static workspaceModels:WorkspaceItemType.Note}">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}"
                                                                 Value="{x:Static workspaceModels:WorkspaceItemType.YouTubeMiniPlayerSet}">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}"
                                                                 Value="{x:Static workspaceModels:WorkspaceItemType.ShellItem}">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="カードをコピー"
                                              Click="DuplicateMenuItem_Click" />
                                    <Separator>
                                        <Separator.Style>
                                            <Style TargetType="{x:Type Separator}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static workspaceModels:WorkspaceItemType.ShellItem}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Separator.Style>
                                    </Separator>
                                    <MenuItem Header="タブで表示"
                                              Style="{StaticResource ShellDirectoryMenuStyle}"
                                              Click="OpenShellFolderInTabMenuItem_Click" />
                                    <MenuItem Header="ミニプレイヤーで再生"
                                              Style="{StaticResource ShellVideoMenuStyle}"
                                              Click="OpenLocalVideoInMiniPlayerMenuItem_Click" />
                                    <MenuItem Header="Explorer で表示"
                                              Style="{StaticResource ShellItemMenuStyle}"
                                              Click="ShowShellItemInFolderMenuItem_Click" />
                                    <MenuItem Header="パスをコピー"
                                              Style="{StaticResource ShellItemMenuStyle}"
                                              Click="CopyShellPathMenuItem_Click" />
                                    <MenuItem Header="参照先を変更..."
                                              Style="{StaticResource ShellItemMenuStyle}"
                                              Click="RelinkShellItemMenuItem_Click" />
                                    <MenuItem Header="メモに変換"
                                              Click="ConvertShellTextFileToNoteMenuItem_Click">
                                        <MenuItem.Style>
                                            <Style TargetType="{x:Type MenuItem}"
                                                   BasedOn="{StaticResource ShellItemMenuStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanConvertShellTextFileToNote}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="実ファイル操作"
                                              Style="{StaticResource ShellItemMenuStyle}">
                                        <MenuItem Header="この場所に実フォルダーを作成..."
                                                  Style="{StaticResource ShellDirectoryMenuStyle}"
                                                  Click="CreateShellDirectoryMenuItem_Click" />
                                        <MenuItem Header="実ファイル名を変更..."
                                                  Click="RenameShellTargetMenuItem_Click" />
                                        <MenuItem Header="コピー先を選択..."
                                                  Click="CopyShellItemMenuItem_Click" />
                                        <MenuItem Header="移動先を選択..."
                                                  Click="MoveShellItemMenuItem_Click" />
                                        <Separator />
                                        <MenuItem Header="ごみ箱へ移動..."
                                                  Click="RecycleShellItemMenuItem_Click" />
                                    </MenuItem>
                                    <MenuItem Header="直前のファイル操作を元に戻す"
                                              Style="{StaticResource ShellItemMenuStyle}"
                                              Click="UndoShellOperationMenuItem_Click" />
                                    <MenuItem Header="選択タブをこのフォルダへ保存"
                                              Click="SaveSelectedTabsToFolderMenuItem_Click">
                                        <MenuItem.Style>
                                            <Style TargetType="{x:Type MenuItem}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}"
                                                                 Value="{x:Static workspaceModels:WorkspaceItemType.Folder}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="全タブをこのフォルダへ保存"
                                              Click="SaveAllTabsToFolderMenuItem_Click">
                                        <MenuItem.Style>
                                            <Style TargetType="{x:Type MenuItem}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}"
                                                                 Value="{x:Static workspaceModels:WorkspaceItemType.Folder}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="名前を変更"
                                              Click="RenameMenuItem_Click">
                                        <MenuItem.Style>
                                            <Style TargetType="{x:Type MenuItem}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}"
                                                                 Value="{x:Static workspaceModels:WorkspaceItemType.Note}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="メモを編集"
                                              Click="EditNoteMenuItem_Click">
                                        <MenuItem.Style>
                                            <Style TargetType="{x:Type MenuItem}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}"
                                                                 Value="{x:Static workspaceModels:WorkspaceItemType.Note}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Workspaceから削除"
                                              Click="DeleteMenuItem_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.ToolTip>
                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                          MaxWidth="420"
                                          MaxHeight="520"
                                          Background="#11141A"
                                          BorderBrush="#3A404D"
                                          BorderThickness="1"
                                          Closed="WorkspaceToolTip_Closed"
                                          Opened="WorkspaceToolTip_Opened"
                                          Placement="Custom"
                                          PreviewMouseWheel="WorkspaceToolTip_PreviewMouseWheel"
                                          StaysOpen="True">
                                    <ScrollViewer Focusable="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                    <Border Padding="10">
                                        <Grid>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="{x:Type StackPanel}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid Width="360"
                                                  Height="112"
                                                  Margin="0,0,0,10"
                                                  Visibility="{Binding IsLeftRightSplitSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="#090B10"
                                                        BorderBrush="#267C8EA3"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding SplitLeftThumbnail}"
                                                               Stretch="UniformToFill" />
                                                        <Grid Background="#10141B">
                                                            <Grid.Style>
                                                                <Style TargetType="{x:Type Grid}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasSplitLeftThumbnail}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Image Width="30"
                                                                   Height="30"
                                                                   Source="{Binding SplitLeftFavicon}"
                                                                   Stretch="Uniform" />
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#67E8F9"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Text="{Binding SplitLeftFallbackText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="{x:Type TextBlock}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasSplitLeftFavicon}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                        <Border VerticalAlignment="Bottom"
                                                                Padding="6,4"
                                                                Background="#D911141A">
                                                            <TextBlock Foreground="#F9FAFB"
                                                                       FontSize="10"
                                                                       Text="{Binding SplitLeftTitle}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Column="2"
                                                        Background="#090B10"
                                                        BorderBrush="#267C8EA3"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding SplitRightThumbnail}"
                                                               Stretch="UniformToFill" />
                                                        <Grid Background="#10141B">
                                                            <Grid.Style>
