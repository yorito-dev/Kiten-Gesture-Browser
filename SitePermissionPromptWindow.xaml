<Window x:Class="TabBrowser.SitePermissionPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="サイト権限"
        Width="440"
        Height="245"
        MinWidth="400"
        MinHeight="220"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource DarkWindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="PromptButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DarkDialogButtonStyle}">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Foreground="#F3F4F6"
                   FontSize="17"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <Border Grid.Row="1"
                Margin="0,14,0,14"
                Padding="12"
                Style="{StaticResource DarkDialogSectionBorderStyle}"
                CornerRadius="4">
            <StackPanel>
                <TextBlock x:Name="OriginText"
                           Foreground="#9CC7FF"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ContainerText"
                           Margin="0,7,0,0"
                           Foreground="#9CA3AF" />
                <TextBlock x:Name="DescriptionText"
                           Margin="0,10,0,0"
                           Foreground="#E5E7EB"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="AllowOnceButton"
                    Content="今回だけ許可"
                    Style="{StaticResource PromptButtonStyle}"
                    Click="AllowOnceButton_Click" />
            <Button x:Name="AllowAlwaysButton"
                    Content="常に許可"
                    Style="{StaticResource PromptButtonStyle}"
                    Click="AllowAlwaysButton_Click" />
            <Button Content="拒否"
                    Style="{StaticResource PromptButtonStyle}"
                    Click="DenyButton_Click" />
        </StackPanel>
    </Grid>
</Window>
