<Window x:Class="TabBrowser.BookmarkFolderInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="フォルダ編集"
        Width="560"
        Height="360"
        MinWidth="460"
        MinHeight="300"
        Background="#101114"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DarkDialogButtonStyle}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText"
                   Grid.Row="0"
                   Margin="0,0,0,8"
                   Foreground="#F3F4F6"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="フォルダ編集" />

        <TextBlock x:Name="DescriptionText"
                   Grid.Row="1"
                   Margin="0,0,0,10"
                   Foreground="#9CA3AF"
                   FontSize="12"
                   TextWrapping="Wrap" />

        <TextBox x:Name="ValueBox"
                 Grid.Row="2"
                 Height="30"
                 VerticalAlignment="Top"
                 Padding="10,5"
                 Foreground="#F3F4F6"
                 Background="#181B22"
                 BorderBrush="#343842"
                 BorderThickness="1"
                 CaretBrush="#F3F4F6"
                 VerticalContentAlignment="Center" />

        <Border x:Name="CandidateHost"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Background="#11141A"
                   BorderBrush="#303541"
                   BorderThickness="1"
                   Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="10,8,10,6"
                           Foreground="#D1D5DB"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="既存フォルダ" />
                <ListBox x:Name="CandidateList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#F3F4F6"
                         SelectionChanged="CandidateList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1D2530" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#284B73" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="10,6"
                                       Foreground="#F3F4F6"
                                       FontSize="12"
                                       Text="{Binding DisplayName}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Margin="0,8,0,8"
                   Style="{StaticResource DarkErrorTextStyle}" />

        <DockPanel Grid.Row="5" LastChildFill="False">
            <Button Content="OK"
                    Click="OkButton_Click"
                    Style="{StaticResource DialogButtonStyle}" />
            <Button DockPanel.Dock="Right"
                    Content="キャンセル"
                    Click="CancelButton_Click"
                    Style="{StaticResource DialogButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
