                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <Border Background="{Binding IconBackground}" CornerRadius="3">
                                                            <Border.Style>
                                                                <Style TargetType="{x:Type Border}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="16" Text="{Binding IconText}" />
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                                <CheckBox x:Name="YouTubeMiniPlayerSelectionCheckBox" Width="26" Height="26" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="2" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Mode=TwoWay}" Style="{StaticResource DarkCheckBoxStyle}" ToolTip="配置対象として選択" />
                                                <Button Width="26" Height="24" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="YouTubeMiniPlayerItemMuteButton_Click" PreviewMouseRightButtonUp="YouTubeMiniPlayerItemMuteButton_PreviewMouseRightButtonUp" Style="{StaticResource ToolbarButtonStyle}" ToolTip="{Binding MuteButtonToolTip}">
