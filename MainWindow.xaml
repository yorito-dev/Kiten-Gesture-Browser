                    <Grid x:Name="CommandPaletteContent">
                    <Border x:Name="CommandPalettePanel" Width="680" Height="560" MaxWidth="{Binding ActualWidth, ElementName=WebHost}" MaxHeight="{Binding ActualHeight, ElementName=WebHost}" Margin="24" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#11141A" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="6" FocusManager.FocusedElement="{Binding ElementName=CommandPaletteSearchBox}" FocusManager.IsFocusScope="True" SizeChanged="CommandPaletteLayout_SizeChanged">
