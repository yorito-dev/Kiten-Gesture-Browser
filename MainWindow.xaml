                                                <Button Width="104" Height="62" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Click="YouTubeMiniPlayerItemThumbnailButton_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="{Binding ThumbnailToolTip}">
