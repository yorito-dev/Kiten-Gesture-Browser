                                <Button x:Name="YouTubeMiniPlayerAbRepeatClearButton" Height="30" Margin="2" Content="消去" Tag="Clear" Click="YouTubeMiniPlayerAbRepeatActionButton_Click" Style="{StaticResource YouTubeMiniPlayerListButtonStyle}" />
                            </UniformGrid>
