                                            <Button Grid.Column="4" Height="24" Margin="6,0,0,0" Padding="8,0" VerticalAlignment="Center" Content="プレビュー" Click="CommandPalettePreviewButton_Click" ToolTip="選択項目をQuickLookで表示" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="CommandPaletteNoResultsText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="14" Text="該当なし" Visibility="Collapsed" />
                        </Grid>
                        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="True">
                            <CheckBox x:Name="CommandPaletteShowAllCheckBox" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="CommandPaletteShowAllCheckBox_Changed" Content="すべて表示" Foreground="#CBD5E1" ToolTip="現在実行できないコマンドも理由付きで表示" Unchecked="CommandPaletteShowAllCheckBox_Changed" />
