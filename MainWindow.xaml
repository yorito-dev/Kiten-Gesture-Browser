                                                        </Trigger>
                                                         <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="YouTubeMiniPlayerSelectionBorder" Property="Background" Value="#243746" />
                                                            <Setter TargetName="YouTubeMiniPlayerSelectionBorder" Property="BorderBrush" Value="#22D3EE" />
                                                             <Setter TargetName="YouTubeMiniPlayerSelectionBorder" Property="BorderThickness" Value="3,1,1,1" />
                                                         </Trigger>
                                                         <DataTrigger Binding="{Binding IsDropBefore}" Value="True">
                                                             <Setter TargetName="YouTubeMiniPlayerSelectionBorder" Property="BorderBrush" Value="#38BDF8" />
                                                             <Setter TargetName="YouTubeMiniPlayerSelectionBorder" Property="BorderThickness" Value="1,3,1,1" />
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding IsDropAfter}" Value="True">
