            <Border x:Name="SplitRightYouTubeControlPanel" Padding="6,4" Background="#B811141A" BorderBrush="#56606F" BorderThickness="1" CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SplitRightYouTubeSpeedDownButton" Width="26" Height="26" Margin="0,0,3,0" Content="-" Click="SplitRightYouTubeSpeedDownButton_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="右ペインの YouTube 再生スピードを下げる" />
                    <Button x:Name="SplitRightYouTubeSpeedResetButton" Width="44" Height="26" Margin="0,0,3,0" Content="1x" Click="SplitRightYouTubeSpeedResetButton_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="右ペインの現在の再生スピード。クリックで 1.0x と前回の速度を切り替える" />
                    <Button x:Name="SplitRightYouTubeSpeedUpButton" Width="26" Height="26" Margin="0,0,3,0" Content="+" Click="SplitRightYouTubeSpeedUpButton_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="右ペインの YouTube 再生スピードを上げる" />
                    <Button x:Name="SplitRightYouTubeLoopButton" Width="58" Height="26" Margin="0" Content="リピOFF" Click="SplitRightYouTubeLoopButton_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="右ペインの YouTube リピート再生を切り替える" />
                </StackPanel>
            </Border>
        </Popup>



        <Popup x:Name="DownloadShelfPopup" AllowsTransparency="True" Focusable="True" Placement="Bottom" PlacementTarget="{Binding ElementName=DownloadsButton}" StaysOpen="False" PopupAnimation="Fade">
            <Border Width="540" MaxHeight="560" Padding="12" Background="#11141A" BorderBrush="#3A404D" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Foreground="#E5E7EB" FontSize="13" FontWeight="SemiBold" Text="ダウンロード" />
                    </DockPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DownloadSearchBox" Grid.Column="0" Height="26" Margin="0,0,8,0" VerticalContentAlignment="Center" TextChanged="DownloadSearchBox_TextChanged" ToolTip="ファイル名、URL、保存先で検索" />
                        <ComboBox x:Name="DownloadKindFilterBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="DownloadKindFilterBox_SelectionChanged" Style="{StaticResource ReadabilityComboBoxStyle}" />
                    </Grid>

                    <ScrollViewer MaxHeight="486" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DownloadList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DownloadItem}">
                                    <Border Margin="0,0,0,8" Padding="10" Background="#151820" BorderBrush="#2E3440" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" Foreground="#F9FAFB" FontSize="13" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Foreground="#CBD5E1" FontSize="12" Text="{Binding StateText}" />
                                             <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="7" Margin="0,7,0,4" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Foreground="#9CA3AF" FontSize="11" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0" Foreground="#9CA3AF" FontSize="11" Text="{Binding TimestampText}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,4,0,0" Foreground="#FCA5A5" FontSize="11" Text="{Binding SafetyWarning}" TextWrapping="Wrap" />
                                            <WrapPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                                <Button Width="58" Height="24" Margin="0,0,6,0" Content="中止" Click="DownloadCancelButton_Click" IsEnabled="{Binding CanCancel}" Style="{StaticResource ToolbarButtonStyle}" />
                                                <Button Width="92" Height="24" Margin="0,0,6,0" Content="保存して継続" Click="DownloadSaveAndContinueButton_Click" IsEnabled="{Binding CanSaveAndContinue}" ToolTip="ここまでを保存し、現在のライブ位置から新しいファイルへ継続します">
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanSaveAndContinue}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Width="72" Height="24" Margin="0,0,6,0" Content="{Binding PauseResumeButtonText}" Click="DownloadPauseResumeButton_Click" IsEnabled="{Binding CanPauseOrResume}" Style="{StaticResource ToolbarButtonStyle}" />
                                                <Button Width="48" Height="24" Margin="0,0,6,0" Content="開く" Click="DownloadOpenButton_Click" IsEnabled="{Binding CanOpen}" Style="{StaticResource ToolbarButtonStyle}" />
                                                <Button Width="72" Height="24" Margin="0,0,6,0" Content="フォルダー" Click="DownloadOpenFolderButton_Click" IsEnabled="{Binding CanOpenFolder}" Style="{StaticResource ToolbarButtonStyle}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="エクスプローラーで開く" Click="DownloadOpenFolderInExplorerMenuItem_Click" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                 <Button Width="70" Height="24" Margin="0,0,6,0" Content="URLコピー" Click="DownloadCopyLinkButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                                                 <Button Width="52" Height="24" Margin="0,0,6,0" Content="詳細" Click="DownloadDetailButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                                                 <Button Width="54" Height="24" Margin="0,0,6,0" Content="再試行" Click="DownloadRetryButton_Click" IsEnabled="{Binding CanRetry}" Style="{StaticResource ToolbarButtonStyle}" />
                                                <Button Width="68" Height="24" Margin="0,0,6,0" Content="履歴削除" Click="DownloadRemoveHistoryButton_Click" IsEnabled="{Binding CanRemoveHistory}" Style="{StaticResource ToolbarButtonStyle}" />
                                                <Button Width="76" Height="24" Content="ファイル削除" Click="DownloadDeleteFileButton_Click" IsEnabled="{Binding CanOpenFolder}" Style="{StaticResource ToolbarButtonStyle}" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <Popup x:Name="AddressSuggestionPopup" Closed="AddressSuggestionPopup_Closed" AllowsTransparency="True" Focusable="False" Placement="Bottom" PlacementTarget="{Binding ElementName=AddressBox}" StaysOpen="False">
            <Border Width="{Binding ActualWidth, ElementName=AddressBox}" MaxHeight="330" Background="#11141A" BorderBrush="#3A404D" BorderThickness="1">
                <ListBox x:Name="AddressSuggestionList" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" PreviewMouseLeftButtonUp="AddressSuggestionList_PreviewMouseLeftButtonUp" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1D2530" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#284B73" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,7,0" Padding="5,1" Background="#202733" BorderBrush="#465061" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Foreground="#C7D2FE" FontSize="10" Text="{Binding KindLabel}" />
                                </Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Foreground="#F3F4F6" FontSize="13" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,3,0,0" Foreground="#C4B5FD" FontSize="11" Text="{Binding SecondaryText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,3,0,0" Foreground="#9CA3AF" FontSize="11" Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>



        <Popup x:Name="TabDragPopup" AllowsTransparency="True" IsHitTestVisible="False" Placement="AbsolutePoint" StaysOpen="True">
            <Border x:Name="TabDragPreview" Width="190" Height="32" Background="#2E3B4F" BorderBrush="#FACC15" BorderThickness="2" Opacity="0.92" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Height="3" VerticalAlignment="Top" Background="#FACC15" />
                    <TextBlock x:Name="TabDragPreviewText" Margin="10,0,10,0" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Border x:Name="TabDragWindowPreviewBody" Grid.Row="1" Margin="8,0,8,8" Background="#151A22" BorderBrush="#445064" BorderThickness="1" ClipToBounds="True" Visibility="Collapsed">
                        <Grid>
                            <Image x:Name="TabDragWindowPreviewThumbnail" Source="{Binding Thumbnail}" Stretch="UniformToFill" SnapsToDevicePixels="True">
                                <Image.Style>
                                    <Style TargetType="{x:Type Image}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Border Background="#660B111A" />
                            <Border Padding="12,7" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#D9151A22" BorderBrush="#66758AA8" BorderThickness="1" CornerRadius="3">
                                <TextBlock Foreground="#F3F4F6" FontSize="13" FontWeight="SemiBold" Text="新しいWindowとして配置" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
