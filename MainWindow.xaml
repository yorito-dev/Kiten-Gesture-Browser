                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <ListBox x:Name="CommandPaletteList" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" PreviewMouseLeftButtonUp="CommandPaletteList_PreviewMouseLeftButtonUp" SelectionChanged="CommandPaletteList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <EventSetter Event="MouseEnter" Handler="CommandPaletteItem_MouseEnter" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="#151922" />
                                        <Setter Property="BorderBrush" Value="#252B36" />
                                        <Setter Property="BorderThickness" Value="1" />
