                                                </Grid>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button Height="26" Width="80" Margin="2,2,2,0" Content="表示修復" Click="YouTubeMiniPlayerItemReloadButton_Click" Style="{StaticResource YouTubeMiniPlayerListButtonStyle}" ToolTip="{Binding ReloadToolTip}" Visibility="{Binding RepairButtonVisibility}" />
                                                    <Button Height="26" Width="80" Margin="2,2,2,0" Content="ライブへ" Click="YouTubeMiniPlayerItemLiveEdgeButton_Click" IsEnabled="{Binding CanSeekToLiveEdge}" Style="{StaticResource YouTubeMiniPlayerListButtonStyle}" ToolTip="現在のライブ配信位置へ移動" Visibility="{Binding LiveEdgeButtonVisibility}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Popup>
                <Popup x:Name="YouTubeMiniPlayerItemMorePopup" Placement="Bottom" VerticalOffset="3" StaysOpen="True" AllowsTransparency="True" Closed="YouTubeMiniPlayerItemMorePopup_Closed" PopupAnimation="Fade">
                    <Border Width="280" Padding="6" Background="#171B22" BorderBrush="#3A404D" BorderThickness="1" CornerRadius="4">
                        <UniformGrid Columns="2">
