<?xml version="1.0" encoding="utf-8"?><Window x:Class="TabBrowser.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:TabBrowser.Models" xmlns:views="clr-namespace:TabBrowser.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" mc:Ignorable="d" Title="TabBrowser" Icon="Assets/AppIcon.ico" Width="1400" Height="1000" MinWidth="760" MinHeight="460" Background="#101114" Activated="Window_Activated" Closing="Window_Closing" ContextMenuOpening="Window_ContextMenuOpening" Deactivated="Window_Deactivated" Loaded="Window_Loaded" PreviewMouseWheel="Window_PreviewMouseWheel" ResizeMode="CanResize" StateChanged="Window_StateChanged" WindowStyle="None" WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#23262D" />
            <Setter Property="BorderBrush" Value="#343842" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="AddressInformationButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#AEB6C4" />
            <Setter Property="Background" Value="#18202A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="AddressInformationButtonBackground" Background="{TemplateBinding Background}" CornerRadius="7,0,0,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AddressInformationButtonBackground" Property="Background" Value="#292E37" />
                                <Setter Property="Foreground" Value="#F3F4F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AddressInformationButtonBackground" Property="Background" Value="#343B47" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="YouTubeMiniPlayerListButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolbarNavigationButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2B303A" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5D6675" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1B1F27" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#8AB4F8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#181B22" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2B3038" />
                                <Setter Property="Foreground" Value="#6B7280" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2B303A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1B1F27" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B7280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowCaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#B91C1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#7F1D1D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResizeThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Panel.ZIndex" Value="60" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#01000000" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#181B22" />
            <Setter Property="BorderBrush" Value="#343842" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#F3F4F6" />
            <Setter Property="Padding" Value="10,5" />
        </Style>

        <Style x:Key="ReadabilityPanelLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReadabilityComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0B0E13" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2563EB" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
            </Style.Resources>
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#181B22" />
            <Setter Property="BorderBrush" Value="#343842" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBoxBorder" Background="#0B0E13" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                            <ToggleButton x:Name="DropDownToggle" Background="Transparent" BorderThickness="0" ClickMode="Press" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <Path Width="8" Height="4" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0 0 L 8 0 L 4 4 Z" Fill="#CBD5E1" Stretch="Fill" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,0,24,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#0B0E13" BorderBrush="#343842" BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True" Background="#0B0E13" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="#5D6675" />
                                <Setter TargetName="ComboBoxBorder" Property="Background" Value="#0F131A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="#8AB4F8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBoxBorder" Property="Background" Value="#11141A" />
                                <Setter Property="Foreground" Value="#6B7280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Foreground" Value="#F3F4F6" />
                        <Setter Property="Background" Value="#0B0E13" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="24" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1D2530" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="#6B7280" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadabilityCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" AllowDrop="True" DragLeave="RootGrid_DragLeave" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop" PreviewMouseMove="RootGrid_PreviewMouseMove" MouseLeave="RootGrid_MouseLeave" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ToolbarRow" Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="WindowBottomResizeRow" Height="8" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" MinHeight="38" Background="#151820" BorderBrush="#262A33" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseRightButtonUp="TitleBar_MouseRightButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="TabList" Grid.Column="0" VerticalAlignment="Top" AllowDrop="True" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" DragLeave="TabList_DragLeave" DragOver="TabList_DragOver" Drop="TabList_Drop" GiveFeedback="TabList_GiveFeedback" QueryContinueDrag="TabList_QueryContinueDrag" PreviewMouseLeftButtonDown="TabList_PreviewMouseLeftButtonDown" PreviewMouseMove="TabList_PreviewMouseMove" PreviewMouseWheel="TabList_PreviewMouseWheel" SizeChanged="TabList_SizeChanged" SelectionChanged="TabList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <EventSetter Event="MouseEnter" Handler="TabItem_MouseEnter" />
                            <EventSetter Event="MouseLeave" Handler="TabItem_MouseLeave" />
                            <Setter Property="Width" Value="{Binding TabItemWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                            <Setter Property="Height" Value="32" />
                            <Setter Property="Margin" Value="0,3,4,3" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Foreground" Value="#F3F4F6" />
                            <Setter Property="Background" Value="#191E27" />
                            <Setter Property="BorderBrush" Value="#303846" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Grid ClipToBounds="False">
                                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Opacity="1" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="TabScale" ScaleX="1" ScaleY="1" />
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <Border x:Name="ContainerPatternOverlay" Background="{Binding ContainerProfilePatternBrush}" Visibility="{Binding ContainerProfileBadgeVisibility}" ToolTip="{Binding ContainerProfileToolTip}" Panel.ZIndex="0" />
                                                    <Border x:Name="TabAccent" Height="2" Margin="1,0" VerticalAlignment="Top" Background="Transparent" CornerRadius="3,3,0,0" />
                                                    <Border x:Name="WorkspaceRail" Width="3" Margin="0,1" HorizontalAlignment="Left" Background="#22D3EE" CornerRadius="2,0,0,2" IsHitTestVisible="False" Panel.ZIndex="5" Visibility="Collapsed" />
                                                    <Border x:Name="DropBeforeIndicator" Width="5" HorizontalAlignment="Left" Background="#FACC15" Opacity="0" Panel.ZIndex="3" />
                                                    <Border x:Name="DropAfterIndicator" Width="5" HorizontalAlignment="Right" Background="#FACC15" Opacity="0" Panel.ZIndex="3" />
                                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </Grid>
                                            </Border>
                                            <Border x:Name="SelectedTabConnection" Height="3" VerticalAlignment="Bottom" Background="#29384A" BorderBrush="#5B7697" BorderThickness="1,0" IsHitTestVisible="False" Panel.ZIndex="6" Visibility="Collapsed" />
                                            <Border x:Name="SplitBottomAccent" Height="2" Margin="1,0" VerticalAlignment="Bottom" Background="{Binding SplitViewAccentBrush}" IsHitTestVisible="False" Opacity="0.55" Panel.ZIndex="7" Visibility="{Binding SplitViewBadgeVisibility}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#222A35" />
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#536073" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Height" Value="35" />
                                                <Setter Property="Margin" Value="0,3,4,0" />
                                                <Setter TargetName="TabBorder" Property="Background" Value="#29384A" />
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#5B7697" />
                                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,0" />
                                                <Setter TargetName="TabBorder" Property="CornerRadius" Value="4,4,0,0" />
                                                <Setter TargetName="TabAccent" Property="Background" Value="#38BDF8" />
                                                <Setter TargetName="SelectedTabConnection" Property="Background" Value="#29384A" />
                                                <Setter TargetName="SelectedTabConnection" Property="Visibility" Value="Visible" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsInSplitView}" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#1E242F" />
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#465166" />
                                                <Setter TargetName="TabAccent" Property="Background" Value="Transparent" />
                                                <Setter TargetName="TabAccent" Property="Opacity" Value="1" />
                                                <Setter TargetName="SelectedTabConnection" Property="Background" Value="#1E242F" />
                                                <Setter TargetName="SelectedTabConnection" Property="BorderBrush" Value="#465166" />
                                                <Setter Property="Foreground" Value="#F5F3FF" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActiveSplitViewTab}" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#232B39" />
                                                <Setter TargetName="SplitBottomAccent" Property="Opacity" Value="0.8" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsInSplitView}" Value="True" />
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="TabBorder" Property="Background" Value="#30425A" />
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#5B7697" />
                                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,0" />
                                                <Setter TargetName="TabAccent" Property="Background" Value="Transparent" />
                                                <Setter TargetName="TabAccent" Property="Opacity" Value="1" />
                                                <Setter TargetName="SplitBottomAccent" Property="Opacity" Value="1" />
                                                <Setter TargetName="SelectedTabConnection" Property="Background" Value="#30425A" />
                                                <Setter TargetName="SelectedTabConnection" Property="BorderBrush" Value="#5B7697" />
                                                <Setter TargetName="SelectedTabConnection" Property="BorderThickness" Value="1,0" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsWorkspaceTab}" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#18242A" />
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3A4655" />
                                                <Setter TargetName="TabAccent" Property="Background" Value="Transparent" />
                                                <Setter TargetName="WorkspaceRail" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="SelectedTabConnection" Property="Background" Value="#18242A" />
                                                <Setter TargetName="SelectedTabConnection" Property="BorderBrush" Value="#3A4655" />
                                                <Setter Property="Foreground" Value="#E0F2FE" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsWorkspaceTab}" Value="True" />
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="TabBorder" Property="Background" Value="#1C3442" />
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#67E8F9" />
                                                <Setter TargetName="TabAccent" Property="Background" Value="#22D3EE" />
                                                <Setter TargetName="SelectedTabConnection" Property="Background" Value="#1C3442" />
                                                <Setter TargetName="SelectedTabConnection" Property="BorderBrush" Value="#67E8F9" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="TabBorder" Storyboard.TargetProperty="Opacity" To="0.62" Duration="0:0:0.08" />
                                                            <DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08" />
                                                            <DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="TabBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                                            <DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.08" />
                                                            <DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.08" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FACC15" />
                                                <Setter TargetName="TabAccent" Property="Background" Value="#FACC15" />
                                                <Setter TargetName="SelectedTabConnection" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFolderFileDropTarget}" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#123244" />
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#22D3EE" />
                                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="2" />
                                                <Setter TargetName="TabAccent" Property="Background" Value="#67E8F9" />
                                                <Setter TargetName="SelectedTabConnection" Property="Background" Value="#123244" />
                                                <Setter TargetName="SelectedTabConnection" Property="BorderBrush" Value="#22D3EE" />
                                                <Setter TargetName="SelectedTabConnection" Property="BorderThickness" Value="2,0" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDropPreviewBefore}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="DropBeforeIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="DropBeforeIndicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.06" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDropPreviewAfter}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="DropAfterIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="DropAfterIndicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.06" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
