                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4B5563" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#263244" />
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8AB4F8" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
