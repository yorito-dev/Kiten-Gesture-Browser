                                                </Path.Style>
                                            </Path>
                                            <Path Data="M13,3 C15.6,5.6 15.6,10.4 13,13" Fill="Transparent" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                <Path.Style>
                                                    <Style TargetType="{x:Type Path}">
                                                        <Setter Property="Stroke" Value="#D1D5DB" />
                                                        <Setter Property="Visibility" Value="Visible" />
