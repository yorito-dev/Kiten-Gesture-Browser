                                         <EventSetter Event="PreviewMouseLeftButtonUp" Handler="YouTubeMiniPlayerListItem_PreviewMouseLeftButtonUp" />
                                        <EventSetter Event="MouseDoubleClick" Handler="YouTubeMiniPlayerListItem_MouseDoubleClick" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
