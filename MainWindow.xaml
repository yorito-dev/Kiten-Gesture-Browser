                                                <WrapPanel Margin="0,2,0,0">
                                                    <TextBlock Margin="0,0,7,0" Foreground="{Binding PlaybackStateBrush}" FontSize="11" Text="{Binding PlaybackStateText}" />
                                                    <TextBlock Margin="0,0,7,0" Foreground="{Binding AudioStateBrush}" FontSize="11" Text="{Binding AudioStateText}" />
                                                    <TextBlock Margin="0,0,7,0" Foreground="#9CA3AF" FontSize="11" Text="{Binding WindowStateText}" Visibility="{Binding WindowStateVisibility}" />
                                                    <TextBlock Margin="0,0,7,0" Foreground="{Binding AudioFocusBrush}" FontSize="11" FontWeight="SemiBold" Text="{Binding AudioFocusText}" Visibility="{Binding AudioFocusVisibility}" />
                                                    <TextBlock Foreground="{Binding DisplayStateBrush}" FontSize="11" FontWeight="SemiBold" Text="{Binding DisplayStateText}" Visibility="{Binding DisplayStateVisibility}" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Width="356" VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="74" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="34" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Height="30" Margin="2" Content="{Binding PrimaryPlaybackButtonText}" Click="YouTubeMiniPlayerItemPlayPauseButton_Click" Style="{StaticResource YouTubeMiniPlayerListButtonStyle}" />
