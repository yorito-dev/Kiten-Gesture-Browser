                            <Button Width="68" Height="30" Margin="2" Content="0.75x" Tag="0.75" Click="YouTubeMiniPlayerItemSpeedButton_Click" Style="{StaticResource YouTubeMiniPlayerListButtonStyle}" />
                            <Button Width="68" Height="30" Margin="2" Content="1x" Tag="1" Click="YouTubeMiniPlayerItemSpeedButton_Click" Style="{StaticResource YouTubeMiniPlayerListButtonStyle}" />
                            <Button Width="68" Height="30" Margin="2" Content="1.25x" Tag="1.25" Click="YouTubeMiniPlayerItemSpeedButton_Click" Style="{StaticResource YouTubeMiniPlayerListButtonStyle}" />
                            <Button Width="68" Height="30" Margin="2" Content="1.5x" Tag="1.5" Click="YouTubeMiniPlayerItemSpeedButton_Click" Style="{StaticResource YouTubeMiniPlayerListButtonStyle}" />
                            <Button Width="68" Height="30" Margin="2" Content="1.75x" Tag="1.75" Click="YouTubeMiniPlayerItemSpeedButton_Click" Style="{StaticResource YouTubeMiniPlayerListButtonStyle}" />
