                                                    <Button Grid.Column="2" Height="30" Margin="2" Content="-10秒" Click="YouTubeMiniPlayerItemSeekBackButton_Click" Style="{StaticResource YouTubeMiniPlayerListButtonStyle}" />
                                                    <Button Grid.Column="3" Height="30" Margin="2" Content="+10秒" Click="YouTubeMiniPlayerItemSeekForwardButton_Click" Style="{StaticResource YouTubeMiniPlayerListButtonStyle}" />
                                                    <Button Grid.Column="4" Height="30" Margin="2" Content="速度" Tag="YouTubeMiniPlayerSpeedPopupTrigger" Click="YouTubeMiniPlayerItemSpeedMenuButton_Click" Style="{StaticResource YouTubeMiniPlayerListButtonStyle}" ToolTip="再生速度を変更" />
                                                    <Button Grid.Column="5" Height="30" Margin="2" Content="…" Click="YouTubeMiniPlayerItemMoreButton_Click" Style="{StaticResource YouTubeMiniPlayerListButtonStyle}" ToolTip="その他の操作" />
