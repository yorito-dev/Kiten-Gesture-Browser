<Window x:Class="TabBrowser.WorkspaceFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TabBrowser.Views"
        Title="{Binding CurrentLocationTitle}"
        Width="920"
        Height="560"
        MinWidth="680"
        MinHeight="420"
        Background="#101114"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#101114">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#11141A"
                BorderBrush="#262A33"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">
                <Button DockPanel.Dock="Right" Content="最近削除した項目" Click="DeletedItemsButton_Click"
                        Foreground="#F3F4F6" Background="#23262D" BorderBrush="#343842" Margin="6,4" />
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="#F3F4F6"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="{Binding CurrentLocationTitle}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock DockPanel.Dock="Right"
                           Width="300"
                           VerticalAlignment="Center"
                           Foreground="#9CA3AF"
                           FontSize="12"
                           Text="{Binding StatusText}"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <views:WorkspaceCanvasView x:Name="WorkspaceCanvas"
                                   Grid.Row="1" />
    </Grid>
</Window>
