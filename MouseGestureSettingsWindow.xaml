<Window x:Class="TabBrowser.MouseGestureSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="マウスジェスチャー設定"
        Width="920"
        Height="760"
        MinWidth="720"
        MinHeight="600"
        Background="#101114"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource DarkDialogTextBoxStyle}" />
        <Style TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource DarkDialogComboBoxStyle}" />
        <Style x:Key="DialogButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DarkDialogButtonStyle}" />
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252B35" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#263B52" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#D1D5DB"
                       Text="開始しきい値" />
            <TextBox x:Name="StartThresholdBox"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="3"
                       VerticalAlignment="Center"
                       Foreground="#D1D5DB"
                       Text="方向しきい値" />
            <TextBox x:Name="DirectionThresholdBox"
                     Grid.Column="4"
                     Margin="8,0,0,0"
                     VerticalContentAlignment="Center" />
            <CheckBox x:Name="PreserveContextMenuCheckBox"
                      Grid.Column="5"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      Foreground="#D1D5DB"
                      Content="短い右クリックではメニューを出す" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="10"
                Background="#11141A"
                BorderBrush="#2A2F3A"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="216" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Text="簡単割り当て" />
                    <TextBlock Margin="10,0,0,0"
                               Foreground="#8FA0B5"
                               Text="対象を選び、右ドラッグを記録して機能を割り当てます。" />
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#D1D5DB"
                               Text="対象" />
                    <ComboBox x:Name="QuickScopeBox"
                              Grid.Column="1"
                              Margin="8,0,0,0"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding ScopeOptions}"
                              SelectedValuePath="Value"
                              SelectionChanged="QuickScopeBox_SelectionChanged" />
                    <Button x:Name="RecordGestureButton"
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            Click="RecordGestureButton_Click"
                            Content="入力を記録"
                            Style="{StaticResource DialogButtonStyle}" />
                    <Border Grid.Column="3"
                            MinWidth="92"
                            Margin="10,0,0,0"
                            Padding="10,4"
                            Background="#181B22"
                            BorderBrush="#343842"
                            BorderThickness="1">
                        <TextBlock x:Name="RecordedRouteText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="未記録" />
                    </Border>
                    <TextBlock x:Name="RecorderStatusText"
                               Grid.Column="4"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#8FA0B5"
                               Text="記録面を右ドラッグしても開始できます。"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <Border x:Name="GestureRecorderSurface"
                        Grid.Row="2"
                        Grid.Column="0"
                        Background="#0D1015"
                        BorderBrush="#343842"
                        BorderThickness="1"
                        Focusable="True"
                        LostMouseCapture="GestureRecorderSurface_LostMouseCapture"
                        PreviewMouseMove="GestureRecorderSurface_PreviewMouseMove"
                        PreviewMouseRightButtonDown="GestureRecorderSurface_PreviewMouseRightButtonDown"
                        PreviewMouseRightButtonUp="GestureRecorderSurface_PreviewMouseRightButtonUp">
                    <Grid ClipToBounds="True">
                        <Canvas x:Name="GestureRecorderCanvas"
                                Background="Transparent">
                            <Polyline x:Name="GestureRecorderPath"
                                      IsHitTestVisible="False"
                                      Stroke="#35CFF0"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeThickness="3" />
                        </Canvas>
                        <TextBlock x:Name="GestureRecorderHintText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#718096"
                                   IsHitTestVisible="False"
                                   Text="ここを右ドラッグ"
                                   TextAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QuickCommandSearchBox"
                             Grid.Row="0"
                             Grid.ColumnSpan="2"
                             TextChanged="QuickCommandSearchBox_TextChanged"
                             ToolTip="機能名、英語ID、分類で検索" />
                    <ListBox x:Name="QuickCommandList"
                             Grid.Row="1"
                             Grid.ColumnSpan="2"
                             MinHeight="140"
                             Margin="0,5,0,5"
                             Background="#0D1015"
                             BorderBrush="#343842"
                             BorderThickness="1"
                             ItemsSource="{Binding QuickCommandOptions}"
                             SelectionChanged="QuickCommandList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Margin="10,0,0,0"
                                               Foreground="#8290A3"
                                               Text="{Binding Category}" />
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="QuickAssignButton"
                            Grid.Row="2"
                            Grid.Column="1"
                            Click="QuickAssignButton_Click"
                            Content="割り当て"
                            IsEnabled="False"
                            Style="{StaticResource DialogButtonStyle}" />
                    <TextBlock x:Name="QuickAssignmentStatusText"
                               Grid.Row="2"
                               Grid.Column="0"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="#8FA0B5"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="#D1D5DB"
                       Text="対象表示" />
            <ComboBox x:Name="MappingScopeFilterBox"
                      Grid.Column="1"
                      Margin="10,0,14,0"
                      DisplayMemberPath="Label"
                      ItemsSource="{Binding MappingScopeFilterOptions}"
                      SelectedValuePath="Value"
                      SelectionChanged="MappingScopeFilterBox_SelectionChanged" />
            <TextBlock VerticalAlignment="Center"
                       Grid.Column="2"
                       Foreground="#D1D5DB"
                       Text="割り当て検索" />
            <TextBox x:Name="MappingSearchBox"
                     Grid.Column="3"
                     Margin="10,0,0,0"
                     TextChanged="MappingSearchBox_TextChanged"
                     ToolTip="コマンド名、英語ID、方向列で検索" />
        </Grid>

        <DataGrid x:Name="MappingsGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  Background="#11141A"
                  BorderBrush="#2A2F3A"
                  BorderThickness="1"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  ItemsSource="{Binding GestureMappings}"
                  RowBackground="#151820"
                  AlternatingRowBackground="#181B22"
                  Foreground="#F3F4F6"
                  CurrentCellChanged="MappingsGrid_CurrentCellChanged"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#1D222B" />
                    <Setter Property="Foreground" Value="#D1D5DB" />
                    <Setter Property="BorderBrush" Value="#343842" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="対象" Width="126">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Margin="6,3"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{Binding ScopeOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                      SelectedValue="{Binding Scope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Value" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="入力" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Margin="6,3"
                                      FontWeight="SemiBold"
                                      IsEditable="True"
                                      ItemsSource="{Binding RouteOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                      Text="{Binding Route, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="動作" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Margin="6,3"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{Binding CommandOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                      SelectedValue="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Command" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="72">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="54"
                                    Height="26"
                                    Margin="6,3"
                                    Padding="0"
                                    Background="#2A2F3A"
                                    BorderBrush="#3A404D"
                                    Click="RemoveMappingButton_Click"
                                    Content="削除"
                                    Foreground="#F3F4F6"
                                    Tag="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="4"
                   Margin="0,8,0,0"
                   Style="{StaticResource DarkErrorTextStyle}"
                   Visibility="Collapsed" />

        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="追加"
                        Click="AddMappingButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button Content="既定に戻す"
                        Click="ResetDefaultsButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="OK"
                        Click="OkButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button Content="キャンセル"
                        Click="CancelButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
