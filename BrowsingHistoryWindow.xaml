<Window x:Class="TabBrowser.BrowsingHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="閲覧履歴"
        Width="980"
        Height="720"
        MinWidth="720"
        MinHeight="460"
        Background="{StaticResource DarkWindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#E5E7EB" />
        </Style>
        <Style TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource DarkDialogTextBoxStyle}" />
        <Style TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource DarkDialogComboBoxStyle}" />
        <Style TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource DarkCheckBoxStyle}" />
        <Style x:Key="HistoryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DarkCompactButtonStyle}">
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Height="30"
                     Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     ToolTip="URL、タイトル、サイトを検索"
                     TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="ContainerFilterBox"
                      Grid.Column="1"
                      Height="30"
                      Margin="0,0,8,0"
                      DisplayMemberPath="Name"
                      SelectionChanged="Filter_SelectionChanged" />
            <ComboBox x:Name="PeriodFilterBox"
                      Grid.Column="2"
                      Height="30"
                      Margin="0,0,8,0"
                      DisplayMemberPath="Name"
                      SelectionChanged="Filter_SelectionChanged" />
            <Button Grid.Column="3"
                    Content="更新"
                    Style="{StaticResource HistoryButtonStyle}"
                    Click="RefreshButton_Click" />
        </Grid>

        <Border x:Name="DeleteConfirmationPanel"
                Grid.Row="1"
                Margin="0,10,0,0"
                Padding="10"
                Style="{StaticResource DarkErrorPanelStyle}"
                Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Content="削除"
                            Style="{StaticResource HistoryButtonStyle}"
                            Click="ConfirmDeleteButton_Click" />
                    <Button Content="キャンセル"
                            Style="{StaticResource HistoryButtonStyle}"
                            Click="CancelDeleteButton_Click" />
                </StackPanel>
                <TextBlock x:Name="DeleteConfirmationText"
                           Margin="0,4,12,0"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DayGroupsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <Border Padding="8,5"
                                        Background="#171C25"
                                        BorderBrush="#303847"
                                        BorderThickness="0,0,0,1">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Label}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding SiteGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Margin="0,5,0,0"
                                                      IsExpanded="{Binding IsExpanded}">
                                                <Expander.Header>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right"
                                                                Margin="10,0,0,0"
                                                                Padding="7,2"
                                                                Tag="{Binding Host}"
                                                                Content="サイト履歴を削除"
                                                                Style="{StaticResource HistoryButtonStyle}"
                                                                Click="DeleteSiteButton_Click" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Foreground="#9CC7FF">
                                                            <Run Text="{Binding Host, Mode=OneWay}" />
                                                            <Run Text="  " />
                                                            <Run Text="{Binding Count, Mode=OneWay}" />
                                                            <Run Text="件" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="16,2,0,0"
                                                                    Padding="8"
                                                                    Background="#11161E"
                                                                    BorderBrush="#27303D"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    MouseLeftButtonDown="HistoryEntry_MouseLeftButtonDown">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                        <MenuItem Header="現在のタブで開く"
                                                                                  Tag="CurrentTab"
                                                                                  Click="OpenEntryMenuItem_Click" />
                                                                        <MenuItem Header="新しいタブで開く"
                                                                                  Tag="NewTab"
                                                                                  Click="OpenEntryMenuItem_Click" />
                                                                        <MenuItem Header="裏タブで開く"
                                                                                  Tag="BackgroundTab"
                                                                                  Click="OpenEntryMenuItem_Click" />
                                                                        <MenuItem Header="分割表示で開く"
                                                                                  Tag="Split"
                                                                                  Click="OpenEntryMenuItem_Click" />
                                                                        <MenuItem Header="新しいWindowで開く"
                                                                                  Tag="NewWindow"
                                                                                  Click="OpenEntryMenuItem_Click" />
                                                                        <Separator />
                                                                        <MenuItem Header="この履歴を削除"
                                                                                  Click="DeleteEntryMenuItem_Click" />
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Grid.Column="0"
                                                                              Margin="0,1,8,0"
                                                                              VerticalAlignment="Top"
                                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                              Click="EntrySelectionCheckBox_Click" />
                                                                    <StackPanel Grid.Column="1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Grid.Column="0"
                                                                                    Margin="0,0,7,0"
                                                                                    Padding="5,1"
                                                                                    VerticalAlignment="Center"
                                                                                    Background="#351820"
                                                                                    BorderBrush="#B74255"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="2"
                                                                                    Visibility="{Binding SourceBadgeVisibility}">
                                                                                <TextBlock Foreground="#FFD2D9"
                                                                                           FontSize="10"
                                                                                           Text="{Binding SourceDisplay}" />
                                                                            </Border>
                                                                            <TextBlock Grid.Column="1"
                                                                                       VerticalAlignment="Center"
                                                                                       FontWeight="SemiBold"
                                                                                       Text="{Binding Entry.Title}"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </Grid>
                                                                        <TextBlock Margin="0,3,0,0"
                                                                                   Foreground="#9CA3AF"
                                                                                   FontSize="11"
                                                                                   Text="{Binding Entry.Url}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2"
                                                                                Margin="12,0,0,0"
                                                                                HorizontalAlignment="Right">
                                                                        <TextBlock HorizontalAlignment="Right"
                                                                                   Foreground="#AEB8C7"
                                                                                   FontSize="11"
                                                                                   Text="{Binding VisitedDisplay}" />
                                                                        <TextBlock Margin="0,3,0,0"
                                                                                   HorizontalAlignment="Right"
                                                                                   Foreground="#778399"
                                                                                   FontSize="10"
                                                                                   Text="{Binding ContainerDisplay}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText"
                       Style="{StaticResource DarkEmptyStateTextStyle}"
                       Text="履歴はありません"
                       Visibility="Collapsed" />
            <TextBlock x:Name="LoadingText"
                       Style="{StaticResource DarkEmptyStateTextStyle}"
                       Text="履歴を読み込んでいます..."
                       Visibility="Collapsed" />
        </Grid>

        <DockPanel Grid.Row="3"
                   Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <Button x:Name="LoadMoreButton"
                        Content="さらに表示"
                        Style="{StaticResource HistoryButtonStyle}"
                        Click="LoadMoreButton_Click" />
                <Button Content="期間を削除"
                        Style="{StaticResource HistoryButtonStyle}"
                        Click="DeletePeriodButton_Click" />
                <Button Content="全履歴を削除"
                        Style="{StaticResource HistoryButtonStyle}"
                        Click="DeleteAllButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="WorkspaceBox"
                          Width="180"
                          Height="28"
                          DisplayMemberPath="Name" />
                <Button x:Name="SaveWorkspaceButton"
                        Content="選択をWorkspaceへ"
                        Style="{StaticResource HistoryButtonStyle}"
                        Click="SaveWorkspaceButton_Click" />
                <Button x:Name="DeleteSelectedButton"
                        Content="選択を削除"
                        Style="{StaticResource HistoryButtonStyle}"
                        Click="DeleteSelectedButton_Click" />
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Margin="0,8,0,0"
                   Style="{StaticResource DarkStatusTextStyle}"
                   FontSize="11" />
    </Grid>
</Window>
