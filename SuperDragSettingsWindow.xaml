<Window x:Class="TabBrowser.SuperDragSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="スーパードラッグ設定"
        Width="880" Height="760" MinWidth="760" MinHeight="600"
        Background="#101114" Foreground="#F3F4F6"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource DarkDialogTextBoxStyle}" />
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource DarkDialogCheckBoxStyle}" />
        <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}"
               BasedOn="{StaticResource DarkDialogButtonStyle}" />
        <Style x:Key="DirectionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,4" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="SuperDragSettingsSection" Padding="12"
                    Background="#11141A" BorderBrush="#2A2F3A" BorderThickness="1">
                <StackPanel>
                    <CheckBox x:Name="SuperDragEnabledCheckBox"
                              Content="スーパードラッグを有効にする（Webページ内の左ドラッグ）" />
                    <TextBlock Margin="0,8,0,10" Foreground="#A8B5C6" TextWrapping="Wrap"
                               Text="選択テキスト・リンク・画像を約30 DIP以上ドラッグし、ページの通常領域で離すと実行します。Escで取消。入力欄・サイトのドロップ領域・修飾キー付き操作は対象外です。リンク付き画像はリンクとして扱います。" />
                    <TextBlock Text="方向を指定して割り当てる" FontWeight="SemiBold" />
                    <Grid x:Name="QuickAssignmentGrid" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="RouteRecorderSurface" Width="270" Height="270" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#0D1015" BorderBrush="#343842" BorderThickness="1"
                                ClipToBounds="True" Focusable="True" Cursor="Pen"
                                PreviewMouseLeftButtonDown="RouteRecorderSurface_MouseLeftButtonDown"
                                PreviewMouseMove="RouteRecorderSurface_MouseMove"
                                PreviewMouseLeftButtonUp="RouteRecorderSurface_MouseLeftButtonUp"
                                LostMouseCapture="RouteRecorderSurface_LostMouseCapture">
                            <Grid IsHitTestVisible="False">
                                <Canvas><Polyline x:Name="RouteRecorderPath" Stroke="#35CFF0" StrokeThickness="3"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas>
                                <TextBlock x:Name="RouteRecorderHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#718096" Text="ここを左ドラッグ" TextAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="RouteAssignmentControls" Grid.Column="2" VerticalAlignment="Top">
                            <TextBlock Text="対象" FontWeight="SemiBold" />
                            <ComboBox x:Name="RouteKindBox" Margin="0,6,0,6" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedIndex="0"
                                      SelectionChanged="RouteKindBox_SelectionChanged" Style="{StaticResource DarkDialogComboBoxStyle}" />
                            <WrapPanel Margin="0,0,0,2">
                                <Button Content="↑ 上" Tag="up" Click="DirectionButton_Click" Style="{StaticResource DirectionButtonStyle}" />
                                <Button Content="→ 右" Tag="right" Click="DirectionButton_Click" Style="{StaticResource DirectionButtonStyle}" />
                                <Button Content="↓ 下" Tag="down" Click="DirectionButton_Click" Style="{StaticResource DirectionButtonStyle}" />
                                <Button Content="← 左" Tag="left" Click="DirectionButton_Click" Style="{StaticResource DirectionButtonStyle}" />
                                <Button Content="クリア" Click="ClearRouteButton_Click" Style="{StaticResource DirectionButtonStyle}" />
                            </WrapPanel>
                            <TextBlock x:Name="RouteStatusText" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"
                                       Text="未指定。左ドラッグ、または矢印ボタンで指定してください。" />
                            <TextBlock Margin="0,6,0,8" Foreground="#8FA0B5" TextWrapping="Wrap"
                                       Text="左ボタンを離すと方向を確定します。上下左右は1方向、L字は直角に2方向。矢印でも順に指定できます。指定し直すときはクリア。記録中はEscで取消。" />
                            <Border x:Name="SelectedRoutePanel" Padding="8" Background="#172333" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="SelectedRouteActionBox" ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource DarkDialogComboBoxStyle}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="0,6,0,0" Foreground="#8FA0B5" TextWrapping="Wrap"
                                       Text="検索などの操作はここでは実行しません。OKで保存します。" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="割り当て一覧" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <ItemsControl x:Name="SuperDragMappingsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource DarkDialogComboBoxStyle}" />
                                    <Button Grid.Column="2" Content="削除" Tag="{Binding}" Click="RemoveRouteButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsAdditional}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,8,0,4" Foreground="#A8B5C6" TextWrapping="Wrap"
                               Text="L字は最初の方向へ30 DIP、曲がって40 DIP以上で認識します。追加していない経路・往復・3段階以上は実行しません。検索先を選ぶ操作はテキストに割り当てられます。" />
                    <TextBlock Margin="0,16,0,4" Text="使う検索先" FontWeight="SemiBold" />
                    <TextBlock Foreground="#A8B5C6" TextWrapping="Wrap"
                               Text="候補から選んで追加すると、テキストの割り当てで選べます。自分で指定する場合は、検索語の位置を {0} にした検索URLを入力してください。例: https://www.google.com/search?q={0}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SearchProviderPresetBox" DisplayMemberPath="Name" SelectedIndex="0"
                                  ToolTip="追加する検索先を選択" Style="{StaticResource DarkDialogComboBoxStyle}" />
                        <Button x:Name="AddPresetSearchProviderButton" Grid.Column="1" Content="追加"
                                Click="AddPresetSearchProviderButton_Click" Style="{StaticResource DialogButtonStyle}" />
                        <Button x:Name="AddSearchProviderButton" Grid.Column="2" Content="自分で指定"
                                Click="AddSearchProviderButton_Click" Style="{StaticResource DialogButtonStyle}" />
                    </Grid>
                    <ItemsControl x:Name="SuperDragSearchProvidersList" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="8" BorderBrush="#2A2F3A" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="削除" Tag="{Binding}"
                                                    Click="RemoveSearchProviderButton_Click" Style="{StaticResource DialogButtonStyle}" />
                                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="検索先の名前" VerticalContentAlignment="Center" />
                                        </DockPanel>
                                        <TextBox Margin="0,6,0,0" Text="{Binding SearchUrlTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="検索URL（検索語の位置を {0} にする）" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,12,0,0" Text="除外するホスト名（1行に1件・サブドメインも除外）" />
                    <TextBox x:Name="SuperDragExcludedHostsBox" Margin="0,6,0,0" Height="72"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Content="スーパードラッグを既定に戻す"
                            Click="ResetSuperDragButton_Click" Style="{StaticResource DialogButtonStyle}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="ValidationErrorText" Foreground="#FCA5A5" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
            <TextBlock Margin="0,0,0,8" Foreground="#9CA3AF" Text="OKで保存し、開いているすべてのウィンドウに適用します。" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="OK" Click="OkButton_Click" Style="{StaticResource DialogButtonStyle}" />
                <Button Content="キャンセル" Click="CancelButton_Click" Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
