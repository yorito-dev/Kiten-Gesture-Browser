<?xml version="1.0" encoding="utf-8"?><Window x:Class="TabBrowser.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="設定" Width="620" Height="640" MinWidth="520" MinHeight="440" Background="#101114" PreviewMouseRightButtonUp="Window_PreviewMouseRightButtonUp" PreviewMouseWheel="Window_PreviewMouseWheel" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource DarkDialogTextBoxStyle}" />
        <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DarkDialogButtonStyle}" />
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource DarkDialogCheckBoxStyle}" />
        <Style x:Key="SettingsTabControlStyle" TargetType="{x:Type TabControl}" BasedOn="{StaticResource DarkDialogTabControlStyle}" />
        <Style x:Key="SettingsTabItemStyle" TargetType="{x:Type TabItem}" BasedOn="{StaticResource DarkDialogTabItemStyle}" />
        <Style x:Key="DarkSettingsSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#22D3EE" />
            <Setter Property="Background" Value="#303846" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Track x:Name="PART_Track" VerticalAlignment="Center" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}" Orientation="{TemplateBinding Orientation}" Value="{TemplateBinding Value}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Height="4" VerticalAlignment="Center" Background="{TemplateBinding Foreground}" Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="SliderThumb" Background="#E5E7EB" BorderBrush="#22D3EE" BorderThickness="2" CornerRadius="8" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SliderThumb" Property="Background" Value="#FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="SliderThumb" Property="Background" Value="#67E8F9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Height="4" VerticalAlignment="Center" Background="{TemplateBinding Background}" Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabControl" Grid.Row="0" PreviewMouseWheel="SettingsTabControl_PreviewMouseWheel" SelectedIndex="0" Style="{StaticResource SettingsTabControlStyle}">
            <TabItem Header="一般" Style="{StaticResource SettingsTabItemStyle}" />
            <TabItem Header="表示・操作" Style="{StaticResource SettingsTabItemStyle}" />
            <TabItem Header="メディア" Style="{StaticResource SettingsTabItemStyle}" />

            <TabItem Header="連携・プライバシー" Style="{StaticResource SettingsTabItemStyle}" />
        </TabControl>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="SearchSettingsSection" Padding="12" Background="#11141A" BorderBrush="#2A2F3A" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" FontWeight="SemiBold" Text="検索" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Foreground="#D1D5DB" Text="検索エンジン名" />
                        <TextBox x:Name="SearchEngineBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#D1D5DB" Text="検索 URL" />
                        <TextBox x:Name="SearchUrlTemplateBox" Grid.Row="2" Grid.Column="1" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Foreground="#9CA3AF" FontSize="12" Text="{}{0} が検索語句に置き換わります。" />
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="検索エイリアス" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="追加" Click="AddSearchAliasButton_Click" Style="{StaticResource DialogButtonStyle}" />
                                    <Button Content="削除" Click="DeleteSearchAliasButton_Click" Style="{StaticResource DialogButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="8,0,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="#9CA3AF" FontSize="12" Text="エイリアス" />
                                <TextBlock Grid.Column="1" Foreground="#9CA3AF" FontSize="12" Text="検索 URL" />
                            </Grid>
                            <ListBox x:Name="SearchAliasList" Height="140" Padding="4" HorizontalContentAlignment="Stretch" Background="#0D1015" BorderBrush="#2A2F3A" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Margin="0,0,6,0" GotKeyboardFocus="SearchAliasEditor_GotKeyboardFocus" Text="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="1" GotKeyboardFocus="SearchAliasEditor_GotKeyboardFocus" Text="{Binding SearchUrlTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="0,6,0,0" Foreground="#9CA3AF" FontSize="12" Text="例: yt 猫の動画。エイリアスと検索語の間に空白を入れます。" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="QuickLookSettingsSection" Margin="0,12,0,0" Padding="12" Background="#11141A" BorderBrush="#2A2F3A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Text="QuickLook" />
                        <CheckBox x:Name="EnableQuickLookCheckBox" Content="QuickLookを有効にする" />
                        <CheckBox x:Name="QuickLookRightPaneCheckBox" Content="QuickLookをペイン表示する" />
                        <StackPanel Margin="20,4,0,4" Orientation="Horizontal">
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#D1D5DB" Text="表示位置" />
                            <ComboBox x:Name="QuickLookPanePlacementBox" Width="110" IsEnabled="{Binding IsChecked, ElementName=QuickLookRightPaneCheckBox}">
                                <ComboBoxItem Content="右側" />
                                <ComboBoxItem Content="下側" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="20,4,0,4" Orientation="Horizontal">
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#D1D5DB" Text="テキスト文字サイズ" />
                            <TextBox x:Name="QuickLookTextFontSizeBox" Width="64" />
                        </StackPanel>
                        <CheckBox x:Name="QuickLookTextWrapCheckBox" Margin="20,0,0,0" Content="テキストの長い行を折り返す" />
                        <CheckBox x:Name="QuickLookAutoPlayMediaCheckBox" Content="動画・音声を表示時に自動再生する" />
                    </StackPanel>
                </Border>

                <Border x:Name="ClipboardHistorySettingsSection" Margin="0,12,0,0" Padding="12" Background="#11141A" BorderBrush="#2A2F3A" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" FontWeight="SemiBold" Text="クリップボード履歴" />
                        <CheckBox x:Name="EnableClipboardHistoryCheckBox" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8" Content="クリップボード履歴を有効にする" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Foreground="#D1D5DB" Text="最大履歴件数" />
                        <TextBox x:Name="ClipboardHistoryMaximumItemCountBox" Grid.Row="2" Grid.Column="1" Width="100" Margin="0,0,0,8" HorizontalAlignment="Left" IsEnabled="{Binding IsChecked, ElementName=EnableClipboardHistoryCheckBox}" />
                        <CheckBox x:Name="CaptureClipboardUrlsCheckBox" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8" IsEnabled="{Binding IsChecked, ElementName=EnableClipboardHistoryCheckBox}" Content="URLを履歴へ記録する" />
                        <CheckBox x:Name="CaptureClipboardFilesCheckBox" Grid.Row="4" Grid.ColumnSpan="2" IsEnabled="{Binding IsChecked, ElementName=EnableClipboardHistoryCheckBox}" Content="ファイルとフォルダーを履歴へ記録する" />
                    </Grid>
                </Border>

                <Border x:Name="BrowsingHistorySettingsSection" Margin="0,12,0,0" Padding="12" Background="#11141A" BorderBrush="#2A2F3A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Text="閲覧履歴" />
                        <CheckBox x:Name="EnableBrowsingHistoryCheckBox" Content="閲覧履歴を保存する" />
                        <TextBlock Margin="0,4,0,6" Foreground="#D1D5DB" Text="履歴に残さないサイト" />
                        <TextBox x:Name="BrowsingHistoryExcludedHostsBox" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsChecked, ElementName=EnableBrowsingHistoryCheckBox}" />
                        <TextBlock Margin="0,5,0,0" Foreground="#9CA3AF" FontSize="12" Text="ホスト名を改行またはカンマで区切ります。例: example.com" />
                        <TextBlock Margin="0,10,0,6" Foreground="#D1D5DB" Text="履歴に残さないコンテナ" />
                        <StackPanel x:Name="BrowsingHistoryExcludedContainersPanel" IsEnabled="{Binding IsChecked, ElementName=EnableBrowsingHistoryCheckBox}" />
                        <TextBlock Margin="0,6,0,0" Foreground="#9CA3AF" FontSize="12" Text="無効化しても、すでに保存された履歴は削除しません。" />
                    </StackPanel>
                </Border>



                <Border x:Name="BehaviorSettingsSection" Margin="0,12,0,0" Padding="12" Background="#11141A" BorderBrush="#2A2F3A" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" FontWeight="SemiBold" Text="動作" />
                        <CheckBox x:Name="EnableCpuSaverCheckBox" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8" Foreground="#D1D5DB" Content="裏タブを一時停止して CPU 使用率を下げる" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#D1D5DB" Text="一時停止までの秒数" />
                        <TextBox x:Name="CpuSaverDelayBox" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" />
                        <CheckBox x:Name="EnableInactiveTabMemorySaverCheckBox" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0" Foreground="#D1D5DB" Content="長時間使っていないタブをメモリに保持したまま休止する" />
                        <CheckBox x:Name="EnableLinkHoverPreviewCheckBox" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0" Foreground="#D1D5DB" Content="リンク先をマウスオーバーでポップアップ表示する" />
                    </Grid>
                </Border>

                <Border x:Name="YouTubeMiniPlayerSettingsSection" Margin="0,12,0,0" Padding="12" Background="#11141A" BorderBrush="#2A2F3A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Text="YouTubeミニプレイヤー" />
                        <CheckBox x:Name="EnableYouTubeMiniPlayerLiveContinuationCheckBox" Content="ライブ終了後、同じ配信者の次のライブへ自動で移動する" />
                        <TextBlock Margin="20,4,0,12" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Text="配信中の別枠を確認できた場合だけ移動します。保存すると、開いているプレイヤーにも反映されます。" />
                        <CheckBox x:Name="EnableYouTubeMiniPlayerHoverAudioPreviewCheckBox" Content="一覧でマウスオーバー中の動画だけを一時視聴する" />
                        <TextBlock Margin="20,4,0,0" Foreground="#9CA3AF" FontSize="11" Text="短時間マウスを止めた場合だけ再生し、一覧から外れると元の音声・再生状態へ戻します。" />
                        <CheckBox x:Name="EnableYouTubeMiniPlayerSizeBasedQualityCheckBox" Margin="0,12,0,0" Content="表示サイズに合わせて画質上限を調整する" />
                        <StackPanel x:Name="YouTubeMiniPlayerQualityThresholdPanel" Margin="20,8,0,0" IsEnabled="{Binding IsChecked, ElementName=EnableYouTubeMiniPlayerSizeBasedQualityCheckBox}">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=EnableYouTubeMiniPlayerSizeBasedQualityCheckBox}" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="#D1D5DB" Text="720pから1080pへ切り替える幅" />
                                <TextBlock x:Name="YouTubeMiniPlayerQualityLowWidthValueText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#67E8F9" FontWeight="SemiBold" />
                            </Grid>
                            <Slider x:Name="YouTubeMiniPlayerQualityLowWidthSlider" Margin="0,4,0,0" Minimum="320" Maximum="2360" SmallChange="20" LargeChange="100" TickFrequency="20" IsSnapToTickEnabled="True" Style="{StaticResource DarkSettingsSliderStyle}" ValueChanged="YouTubeMiniPlayerQualityWidthSlider_ValueChanged" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="#D1D5DB" Text="1080pから1440pへ切り替える幅" />
                                <TextBlock x:Name="YouTubeMiniPlayerQualityHighWidthValueText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#67E8F9" FontWeight="SemiBold" />
                            </Grid>
                            <Slider x:Name="YouTubeMiniPlayerQualityHighWidthSlider" Margin="0,4,0,0" Minimum="520" Maximum="2560" SmallChange="20" LargeChange="100" TickFrequency="20" IsSnapToTickEnabled="True" Style="{StaticResource DarkSettingsSliderStyle}" ValueChanged="YouTubeMiniPlayerQualityWidthSlider_ValueChanged" />
                            <TextBlock Margin="0,6,0,0" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Text="2つの境界には200px以上の差が必要です。境界が近すぎると、わずかなWindowサイズ変更で画質が頻繁に切り替わるためです。" />
                            <Border Margin="0,8,0,0" Padding="8,6" Background="#0D1117" BorderBrush="#2A3442" BorderThickness="1" CornerRadius="3">
                                <TextBlock x:Name="YouTubeMiniPlayerQualityRangeSummaryText" Foreground="#B8C4D4" FontSize="11" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Margin="0,6,0,0" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Text="全画面とYouTube側で手動選択した動画は制限しません。スライダー操作は保存するまで再生中の動画へ反映しません。" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="DownloadSettingsSection" Margin="0,12,0,0" Padding="12" Background="#11141A" BorderBrush="#2A2F3A" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10" FontWeight="SemiBold" Text="ダウンロード" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#D1D5DB" Text="既定保存先" />
                        <TextBox x:Name="DefaultDownloadDirectoryBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" />
                        <Button Grid.Row="1" Grid.Column="2" Content="参照" Click="BrowseDownloadDirectoryButton_Click" Style="{StaticResource DialogButtonStyle}" />
                        <CheckBox x:Name="AskDownloadLocationCheckBox" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0" Foreground="#D1D5DB" Content="毎回保存先を確認する" />
                        <CheckBox x:Name="OpenDownloadShelfOnStartCheckBox" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0" Foreground="#D1D5DB" Content="ダウンロード開始時に一覧を開く" />
                        <CheckBox x:Name="OpenDownloadShelfOnCompleteCheckBox" Grid.Row="4" Grid.ColumnSpan="3" Margin="0,8,0,0" Foreground="#D1D5DB" Content="ダウンロード完了時に一覧を開く" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#D1D5DB" Text="履歴保持件数" />
                            <TextBox x:Name="DownloadHistoryRetentionLimitBox" Width="86" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="12" Text="0 は無制限" />
                        </StackPanel>
                    </Grid>
                </Border>



                <Border x:Name="BrowserSettingsSection" Margin="0,12,0,0" Padding="12" Background="#11141A" BorderBrush="#2A2F3A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Text="ブラウザ" />
                        <CheckBox x:Name="EnableExtensionsCheckBox" Foreground="#D1D5DB" Content="拡張機能を有効にする" />
                        <TextBlock Margin="0,6,0,0" Foreground="#9CA3AF" FontSize="12" Text="WebView2 環境作成後の変更は、次回起動後に完全反映されます。" />
                    </StackPanel>
                </Border>



                <Border x:Name="ContainerSettingsSection" Margin="0,12,0,0" Padding="12" Background="#11141A" BorderBrush="#2A2F3A" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" FontWeight="SemiBold" Text="コンテナプロファイル" />

                        <ListBox x:Name="ContainerProfileList" Grid.Row="1" Grid.ColumnSpan="2" Height="128" Margin="0,0,0,10" Background="#0F1117" BorderBrush="#343842" BorderThickness="1" Foreground="#F3F4F6" SelectionChanged="ContainerProfileList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,3">
                                        <Border Width="8" Height="18" Margin="0,0,8,0" Background="{Binding Color}" BorderBrush="#4B5563" BorderThickness="1" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Foreground="#D1D5DB" Text="名前" />
                        <TextBox x:Name="ContainerProfileNameBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#D1D5DB" Text="色" />
                        <WrapPanel Grid.Row="3" Grid.Column="1">
                            <TextBox x:Name="ContainerProfileColorBox" Width="110" Margin="0,0,8,0" />
                            <Button x:Name="AddContainerProfileButton" Content="追加" Click="AddContainerProfileButton_Click" Style="{StaticResource DialogButtonStyle}" />
                            <Button x:Name="SaveContainerProfileButton" Content="保存" Click="SaveContainerProfileButton_Click" Style="{StaticResource DialogButtonStyle}" />
                            <Button x:Name="DeleteContainerProfileButton" Content="削除" Click="DeleteContainerProfileButton_Click" Style="{StaticResource DialogButtonStyle}" />
                            <Button x:Name="DeleteContainerProfileDataButton" Content="データ削除" Click="DeleteContainerProfileDataButton_Click" Style="{StaticResource DialogButtonStyle}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border x:Name="ToolbarSettingsSection" Margin="0,12,0,0" Padding="12" Background="#11141A" BorderBrush="#2A2F3A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Text="ツールバー表示" />
                        <CheckBox x:Name="AutoHideToolbarCheckBox" Content="上部ツールバーを自動的に隠す" />
                        <WrapPanel>
                            <CheckBox x:Name="ShowBackButtonCheckBox" Width="130" Content="戻る" />
                            <CheckBox x:Name="ShowForwardButtonCheckBox" Width="130" Content="進む" />
                            <CheckBox x:Name="ShowReloadButtonCheckBox" Width="130" Content="更新" />
                            <CheckBox x:Name="ShowRestoreButtonCheckBox" Width="130" Content="復元" />
                            <CheckBox x:Name="ShowClosedTabHistoryButtonCheckBox" Width="130" Content="閉じたタブ履歴" />
                            <CheckBox x:Name="ShowAddressBoxCheckBox" Width="130" Content="アドレスバー" />
                            <CheckBox x:Name="ShowGoButtonCheckBox" Width="130" Content="移動" />
                            <CheckBox x:Name="ShowActionsButtonCheckBox" Width="130" Content="操作メニュー" />
                            <CheckBox x:Name="ShowAddBookmarkButtonCheckBox" Width="130" Content="ブックマーク追加" />
                            <CheckBox x:Name="ShowBookmarkListButtonCheckBox" Width="130" Content="ブックマーク一覧" />
                            <CheckBox x:Name="ShowWorkspaceOSButtonCheckBox" Width="130" Content="Workspace OS" />

                            <CheckBox x:Name="ShowToolsButtonCheckBox" Width="130" Content="ツールメニュー" />
                            <CheckBox x:Name="ShowAddExtensionButtonCheckBox" Width="130" Content="拡張追加" />
                            <CheckBox x:Name="ShowImportExtensionButtonCheckBox" Width="130" Content="拡張取込" />
                            <CheckBox x:Name="ShowManageExtensionsButtonCheckBox" Width="130" Content="拡張管理" />
                            <CheckBox x:Name="ShowGestureSettingsButtonCheckBox" Width="130" Content="ジェスチャー設定" />
                            <CheckBox x:Name="ShowSettingsButtonCheckBox" Width="130" Content="設定" />
                            <CheckBox x:Name="ShowExtensionIconsCheckBox" Width="130" Content="拡張アイコン" />
                            <CheckBox x:Name="ShowStatusTextCheckBox" Width="130" Content="状態表示" />
                        </WrapPanel>
                    </StackPanel>
                </Border>



                <Border x:Name="GestureSettingsSection" Margin="0,12,0,0" Padding="12" Background="#11141A" BorderBrush="#2A2F3A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold" Text="マウスジェスチャー" />
                            <TextBlock x:Name="GestureSummaryText" Margin="0,6,0,0" Foreground="#9CA3AF" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="設定" Click="OpenGestureSettingsButton_Click" Style="{StaticResource DialogButtonStyle}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource DarkErrorTextStyle}" Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="OK" Click="OkButton_Click" Style="{StaticResource DialogButtonStyle}" />
            <Button Content="キャンセル" Click="CancelButton_Click" Style="{StaticResource DialogButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
