<Window x:Class="TabBrowser.SitePrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="サイト権限・プライバシー"
        Width="820"
        Height="620"
        MinWidth="680"
        MinHeight="480"
        Background="{StaticResource DarkWindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="PrivacyButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DarkCompactButtonStyle}">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#E5E7EB" />
        </Style>
        <Style TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource DarkDialogComboBoxStyle}" />
        <Style TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource DarkCheckBoxStyle}" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Content="更新"
                    Style="{StaticResource PrivacyButtonStyle}"
                    Click="RefreshButton_Click" />
            <TextBlock DockPanel.Dock="Left"
                       Margin="0,5,8,0"
                       Text="コンテナ" />
            <ComboBox x:Name="ContainerBox"
                      Width="220"
                      Height="29"
                      DisplayMemberPath="Name"
                      SelectionChanged="ContainerBox_SelectionChanged" />
        </DockPanel>

        <TabControl Grid.Row="1"
                    Margin="0,12,0,0"
                    Background="{StaticResource DarkWindowBackgroundBrush}"
                    BorderBrush="#303847"
                    Foreground="#E5E7EB">
            <TabItem Header="サイト権限">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="PermissionGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Background="#10151D"
                              BorderBrush="#303847"
                              Foreground="#E5E7EB"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              SelectionChanged="PermissionGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="サイト"
                                                Binding="{Binding Origin}"
                                                Width="*" />
                            <DataGridTextColumn Header="権限"
                                                Binding="{Binding PermissionName}"
                                                Width="130" />
                            <DataGridTextColumn Header="状態"
                                                Binding="{Binding StateName}"
                                                Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="1"
                               Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="サイトを既定へ"
                                Style="{StaticResource PrivacyButtonStyle}"
                                Click="ResetOriginButton_Click" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AllowPermissionButton"
                                    Content="許可"
                                    IsEnabled="False"
                                    Style="{StaticResource PrivacyButtonStyle}"
                                    Click="AllowPermissionButton_Click" />
                            <Button x:Name="DenyPermissionButton"
                                    Content="拒否"
                                    IsEnabled="False"
                                    Style="{StaticResource PrivacyButtonStyle}"
                                    Click="DenyPermissionButton_Click" />
                            <Button x:Name="ResetPermissionButton"
                                    Content="既定へ戻す"
                                    IsEnabled="False"
                                    Style="{StaticResource PrivacyButtonStyle}"
                                    Click="ResetPermissionButton_Click" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="ポップアップ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="PopupRuleGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Background="#10151D"
                              BorderBrush="#303847"
                              Foreground="#E5E7EB"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              SelectionChanged="PopupRuleGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="サイト"
                                                Binding="{Binding Origin}"
                                                Width="*" />
                            <DataGridTextColumn Header="状態"
                                                Binding="{Binding PolicyName}"
                                                Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="AllowPopupButton"
                                Content="許可"
                                IsEnabled="False"
                                Style="{StaticResource PrivacyButtonStyle}"
                                Click="AllowPopupButton_Click" />
                        <Button x:Name="BlockPopupRuleButton"
                                Content="ブロック"
                                IsEnabled="False"
                                Style="{StaticResource PrivacyButtonStyle}"
                                Click="BlockPopupRuleButton_Click" />
                        <Button x:Name="ResetPopupRuleButton"
                                Content="既定へ戻す"
                                IsEnabled="False"
                                Style="{StaticResource PrivacyButtonStyle}"
                                Click="ResetPopupRuleButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="閲覧データ削除">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="#F3F4F6"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="削除するデータ" />
                    <WrapPanel Grid.Row="1"
                               Margin="0,12,0,0">
                        <CheckBox x:Name="CacheCheckBox"
                                  Margin="0,0,18,8"
                                  Content="キャッシュ" />
                        <CheckBox x:Name="SiteDataCheckBox"
                                  Margin="0,0,18,8"
                                  Content="Cookieとサイトストレージ" />
                        <CheckBox x:Name="BrowsingHistoryCheckBox"
                                  Margin="0,0,18,8"
                                  Content="閲覧履歴" />
                        <CheckBox x:Name="DownloadHistoryCheckBox"
                                  Margin="0,0,18,8"
                                  Content="ダウンロード履歴" />
                        <CheckBox x:Name="AllDataCheckBox"
                                  Margin="0,0,18,8"
                                  Content="すべて"
                                  Click="AllDataCheckBox_Click" />
                    </WrapPanel>
                    <DockPanel Grid.Row="2"
                               Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="削除内容を確認"
                                Style="{StaticResource PrivacyButtonStyle}"
                                Click="PrepareClearDataButton_Click" />
                        <TextBlock DockPanel.Dock="Left"
                                   Margin="0,5,8,0"
                                   Text="期間" />
                        <ComboBox x:Name="PeriodBox"
                                  Width="180"
                                  Height="29"
                                  DisplayMemberPath="Name" />
                    </DockPanel>
                    <Border x:Name="ClearConfirmationPanel"
                            Grid.Row="3"
                            Margin="0,18,0,0"
                            Padding="12"
                            VerticalAlignment="Top"
                            Background="#291C20"
                            BorderBrush="#A14B5A"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ClearConfirmationText"
                                       Foreground="#F3F4F6"
                                       TextWrapping="Wrap" />
                            <StackPanel Margin="0,12,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Content="削除を実行"
                                        Style="{StaticResource PrivacyButtonStyle}"
                                        Click="ConfirmClearDataButton_Click" />
                                <Button Content="キャンセル"
                                        Style="{StaticResource PrivacyButtonStyle}"
                                        Click="CancelClearDataButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="0,9,0,0"
                   Style="{StaticResource DarkStatusTextStyle}"
                   FontSize="11"
                   TextWrapping="Wrap" />

        <Grid x:Name="ProfileWebViewHost"
              Width="1"
              Height="1"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              IsHitTestVisible="False"
              Opacity="0" />
    </Grid>
</Window>
