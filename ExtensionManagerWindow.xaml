<Window x:Class="TabBrowser.ExtensionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拡張機能の管理"
        Width="760"
        Height="460"
        MinWidth="620"
        MinHeight="360"
        Background="#101114"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DarkDialogButtonStyle}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Foreground="#F3F4F6"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="拡張機能" />

        <DataGrid x:Name="ExtensionGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding Extensions}"
                  SelectionChanged="ExtensionGrid_SelectionChanged"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Background="#11141A"
                  Foreground="#F3F4F6"
                  BorderBrush="#303541"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#303541"
                  RowBackground="#171A22"
                  AlternatingRowBackground="#141720"
                  ColumnHeaderHeight="30"
                  RowHeight="34">
            <DataGrid.Resources>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#1D2028" />
                    <Setter Property="Foreground" Value="#D1D5DB" />
                    <Setter Property="BorderBrush" Value="#303541" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="Padding" Value="8,0" />
                </Style>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#284B73" />
                            <Setter Property="BorderBrush" Value="#73B7FF" />
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="#F3F4F6" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header=""
                                        Width="42">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Width="24"
                                  Height="24"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Image Width="20"
                                       Height="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="{Binding Icon}"
                                       Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="{x:Type Image}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#F3F4F6"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding Initial}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="名前"
                                    Binding="{Binding Name}"
                                    Width="2*" />
                <DataGridTextColumn Header="状態"
                                    Binding="{Binding EnabledText}"
                                    Width="90" />
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10,8"
                Background="#151A22"
                BorderBrush="#303541"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="#9CA3AF"
                           FontSize="12"
                           Text="選択中" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="SelectedNameText"
                               Foreground="#F3F4F6"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="未選択"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SelectedIdText"
                               Margin="0,3,0,0"
                               Foreground="#9CA3AF"
                               FontSize="11"
                               Text="一覧から拡張機能を選択してください"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="2"
                        MinWidth="52"
                        Height="24"
                        Padding="10,0"
                        VerticalAlignment="Center"
                        Background="#23262D"
                        BorderBrush="#3A404D"
                        BorderThickness="1">
                    <TextBlock x:Name="SelectedStateText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#D1D5DB"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="-" />
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,8,0,8"
                   Style="{StaticResource DarkStatusTextStyle}" />

        <DockPanel Grid.Row="4" LastChildFill="False">
            <StackPanel Orientation="Horizontal">
                <Button Content="更新"
                        Click="RefreshButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="OpenSettingsButton"
                        Content="設定"
                        IsEnabled="False"
                        Click="OpenSettingsButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="ToggleExtensionButton"
                        Content="ON/OFF"
                        IsEnabled="False"
                        Click="ToggleButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="RemoveExtensionButton"
                        Content="削除"
                        IsEnabled="False"
                        Click="RemoveButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="閉じる"
                    Click="CloseButton_Click"
                    Style="{StaticResource DialogButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
