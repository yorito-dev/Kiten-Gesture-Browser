<Window x:Class="TabBrowser.ExtensionImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chrome/Edge 拡張機能の取り込み"
        Width="900"
        Height="540"
        MinWidth="720"
        MinHeight="420"
        Background="#101114"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DarkDialogButtonStyle}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Foreground="#F3F4F6"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="Chrome/Edge にインストール済みの拡張機能" />

        <DataGrid x:Name="CandidateGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding Candidates}"
                  MouseDoubleClick="CandidateGrid_MouseDoubleClick"
                  SelectionChanged="CandidateGrid_SelectionChanged"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Background="#11141A"
                  Foreground="#F3F4F6"
                  BorderBrush="#303541"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#303541"
                  RowBackground="#171A22"
                  AlternatingRowBackground="#141720"
                  ColumnHeaderHeight="30"
                  RowHeight="34">
            <DataGrid.Resources>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#1D2028" />
                    <Setter Property="Foreground" Value="#D1D5DB" />
                    <Setter Property="BorderBrush" Value="#303541" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="Padding" Value="8,0" />
                </Style>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#284B73" />
                            <Setter Property="BorderBrush" Value="#73B7FF" />
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="#F3F4F6" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header=""
                                        Width="42">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Width="24"
                                  Height="24"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Image Width="20"
                                       Height="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="{Binding Icon}"
                                       Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="{x:Type Image}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#F3F4F6"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding Initial}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ブラウザ"
                                    Binding="{Binding BrowserName}"
                                    Width="90" />
                <DataGridTextColumn Header="名前"
                                    Binding="{Binding Name}"
                                    Width="2*" />
                <DataGridTextColumn Header="バージョン"
                                    Binding="{Binding VersionText}"
                                    Width="120" />
                <DataGridTextColumn Header="プロファイル"
                                    Binding="{Binding ProfileName}"
                                    Width="140" />
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding ExtensionId}"
                                    Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10,8"
                Background="#151A22"
                BorderBrush="#303541"
                BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="SelectedNameText"
                           Foreground="#F3F4F6"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="未選択"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SelectedPathText"
                           Margin="0,3,0,0"
                           Foreground="#9CA3AF"
                           FontSize="11"
                           Text="一覧から取り込む拡張機能を選択してください"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SelectedDescriptionText"
                           Margin="0,3,0,0"
                           Foreground="#D1D5DB"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,8,0,8"
                   Style="{StaticResource DarkStatusTextStyle}" />

        <DockPanel Grid.Row="4" LastChildFill="False">
            <StackPanel Orientation="Horizontal">
                <Button Content="更新"
                        Click="RefreshButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="ImportButton"
                        Content="取り込む"
                        IsEnabled="False"
                        Click="ImportButton_Click"
                        Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="閉じる"
                    Click="CloseButton_Click"
                    Style="{StaticResource DialogButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
