<Application x:Class="TabBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TabBrowser"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="DarkWindowBackgroundBrush" Color="#101114" />
        <SolidColorBrush x:Key="DarkControlBackgroundBrush" Color="#1A1F27" />
        <SolidColorBrush x:Key="DarkControlHoverBrush" Color="#263242" />
        <SolidColorBrush x:Key="DarkControlPressedBrush" Color="#182231" />
        <SolidColorBrush x:Key="DarkControlForegroundBrush" Color="#F3F6FA" />
        <SolidColorBrush x:Key="DarkControlSubtleForegroundBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="DarkControlDisabledForegroundBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="DarkControlBorderBrush" Color="#3A4656" />
        <SolidColorBrush x:Key="DarkControlAccentBrush" Color="#67B7DC" />
        <SolidColorBrush x:Key="DarkDialogSurfaceBrush" Color="#181B22" />
        <SolidColorBrush x:Key="DarkDialogButtonBrush" Color="#23262D" />
        <SolidColorBrush x:Key="DarkDialogBorderBrush" Color="#343842" />
        <SolidColorBrush x:Key="DarkDialogSecondaryTextBrush" Color="#9CA3AF" />
        <SolidColorBrush x:Key="DarkDialogErrorTextBrush" Color="#FCA5A5" />
        <SolidColorBrush x:Key="DarkDialogErrorBackgroundBrush" Color="#291C20" />
        <SolidColorBrush x:Key="DarkDialogErrorBorderBrush" Color="#A14B5A" />

        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1A1F27" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#26303C" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#303B49" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#11151B" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#0A0D11" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F3F6FA" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#11141A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F3F6FA" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#315A78" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6B7280" />

        <Style TargetType="{x:Type Window}">
            <Setter Property="Background" Value="{StaticResource DarkWindowBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DarkControlForegroundBrush}" />
        </Style>

        <Style x:Key="DarkButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource DarkControlForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource DarkControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource DarkControlHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#52647A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource DarkControlPressedBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource DarkControlAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource DarkControlAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DarkControlDisabledForegroundBrush}" />
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DarkButtonStyle}" />
        <Style x:Key="DarkCompactButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="9,0" />
        </Style>
        <Style x:Key="DarkDialogButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource DarkDialogButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkDialogBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{StaticResource DarkControlForegroundBrush}" />
            <Setter Property="Background" Value="#11151B" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource DarkControlForegroundBrush}" />
            <Setter Property="SelectionBrush" Value="#315A78" />
            <Setter Property="SelectionTextBrush" Value="#FFFFFF" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource DarkTextBoxStyle}" />
        <Style x:Key="DarkDialogTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource DarkTextBoxStyle}">
            <Setter Property="Background" Value="{StaticResource DarkDialogSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkDialogBorderBrush}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style x:Key="DarkPasswordBoxStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Foreground" Value="{StaticResource DarkControlForegroundBrush}" />
            <Setter Property="Background" Value="#11151B" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource DarkControlForegroundBrush}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource DarkPasswordBoxStyle}" />

        <Style x:Key="DarkComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1A1F27" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F3F6FA" />
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#11151B" />
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F3F6FA" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#315A78" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
            </Style.Resources>
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource DarkControlForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource DarkControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2" />

                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Grid Background="Transparent">
                                            <ContentPresenter x:Name="SelectedContent"
                                                              Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                              ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                              ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                              IsHitTestVisible="False" />
                                            <Path Width="8"
                                                  Height="5"
                                                  Margin="0,0,9,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                  IsHitTestVisible="False"
                                                  Stretch="Fill" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                         Value="True">
                                                <Setter TargetName="SelectedContent" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="4,2,28,2"
                                     Padding="2,1"
                                     VerticalContentAlignment="Center"
                                     Background="{TemplateBinding Background}"
                                     BorderThickness="0"
                                     CaretBrush="{TemplateBinding Foreground}"
                                     Foreground="{TemplateBinding Foreground}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Style="{x:Null}"
                                     Visibility="Collapsed" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#11151B"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#52647A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource DarkControlAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DarkControlDisabledForegroundBrush}" />
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource DarkComboBoxStyle}" />
        <Style x:Key="DarkDialogComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource DarkComboBoxStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource DarkControlForegroundBrush}" />
            <Setter Property="Background" Value="#11151B" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DarkControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#315A78" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DarkControlDisabledForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#315A78" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DarkControlDisabledForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource DarkControlSubtleForegroundBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Width="15"
                                    Height="15"
                                    VerticalAlignment="Center"
                                    Background="#11151B"
                                    BorderBrush="{StaticResource DarkControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <Path x:Name="CheckMark"
                                      Width="9"
                                      Height="7"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M1,3.5 L3.5,6 L8,1"
                                      Stroke="{StaticResource DarkControlAccentBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              ContentSource="Content"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#172636" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource DarkControlAccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#7DD3FC" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#7DD3FC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DarkControlDisabledForegroundBrush}" />
                                <Setter TargetName="CheckBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource DarkCheckBoxStyle}" />
        <Style x:Key="DarkDialogCheckBoxStyle"
               TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource DarkCheckBoxStyle}">
            <Setter Property="Margin" Value="0,0,12,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DarkDialogTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <TabPanel IsItemsHost="True"
                                  Background="Transparent"
                                  KeyboardNavigation.TabIndex="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkDialogTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Foreground" Value="#AEB6C4" />
            <Setter Property="Background" Value="#151922" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkDialogBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="HeaderBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#1D2330" />
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#4B5563" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#F9FAFB" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#263244" />
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#8AB4F8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkDialogSectionBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource DarkDialogSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkDialogBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DarkStatusTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource DarkDialogSecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="DarkEmptyStateTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource DarkStatusTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DarkErrorTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource DarkStatusTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource DarkDialogErrorTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DarkErrorPanelStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource DarkDialogErrorBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkDialogErrorBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="#11141A" />
            <Setter Property="Foreground" Value="{StaticResource DarkControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkControlBorderBrush}" />
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource DarkControlForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#315A78" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkDataGridStyle" TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="#11141A" />
            <Setter Property="Foreground" Value="{StaticResource DarkControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkControlBorderBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="#29313C" />
            <Setter Property="VerticalGridLinesBrush" Value="#29313C" />
            <Setter Property="RowBackground" Value="#12161C" />
            <Setter Property="AlternatingRowBackground" Value="#171C24" />
        </Style>
        <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource DarkDataGridStyle}" />
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#1D232C" />
            <Setter Property="Foreground" Value="{StaticResource DarkControlSubtleForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkControlBorderBrush}" />
        </Style>
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Foreground" Value="{StaticResource DarkControlForegroundBrush}" />
            <Setter Property="Background" Value="#12161C" />
        </Style>
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="{StaticResource DarkControlForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#29313C" />
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#151A21" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#3A4656" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#0D1117" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#52647A" />
            </Style.Resources>
            <Setter Property="Background" Value="#11151B" />
            <Setter Property="Foreground" Value="#52647A" />
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1A1F27" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#0D1117" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#67B7DC" />
            </Style.Resources>
            <Setter Property="Foreground" Value="{StaticResource DarkControlAccentBrush}" />
            <Setter Property="Background" Value="#11151B" />
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Foreground" Value="{StaticResource DarkControlForegroundBrush}" />
            <Setter Property="Background" Value="#11141A" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <SolidColorBrush x:Key="DarkContextMenuBackgroundBrush" Color="#101318" />
        <SolidColorBrush x:Key="DarkContextMenuItemBackgroundBrush" Color="#151922" />
        <SolidColorBrush x:Key="DarkContextMenuForegroundBrush" Color="#F3F6FA" />
        <SolidColorBrush x:Key="DarkContextMenuSubtleForegroundBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="DarkContextMenuBorderBrush" Color="#2A3340" />
        <SolidColorBrush x:Key="DarkContextMenuHoverBrush" Color="#223044" />
        <SolidColorBrush x:Key="DarkContextMenuPressedBrush" Color="#1A2535" />
        <SolidColorBrush x:Key="DarkContextMenuDisabledForegroundBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="DarkContextMenuCheckBrush" Color="#8AB4F8" />

        <Style TargetType="{x:Type ContextMenu}">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#101318" />
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F3F6FA" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#101318" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F3F6FA" />
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#101318" />
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F3F6FA" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#223044" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F3F6FA" />
                <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6B7280" />
            </Style.Resources>
            <Setter Property="Background" Value="{StaticResource DarkContextMenuBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DarkContextMenuForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DarkContextMenuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#101318" />
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F3F6FA" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#101318" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F3F6FA" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#223044" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F3F6FA" />
                <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6B7280" />
            </Style.Resources>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DarkContextMenuForegroundBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <Border x:Name="ItemBackground"
                                    Margin="2,1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="3" />
                            <Grid MinWidth="214"
                                  MinHeight="{TemplateBinding MinHeight}"
                                  Margin="0"
                                  SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconPresenter"
                                                  Grid.Column="0"
                                                  Width="16"
                                                  Height="16"
                                                  Margin="7,0,5,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Icon"
                                                  RecognizesAccessKey="True" />
                                <Path x:Name="CheckMark"
                                      Grid.Column="0"
                                      Width="11"
                                      Height="8"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M1,4 L4,7 L10,1"
                                      Stroke="{StaticResource DarkContextMenuCheckBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                                <ContentPresenter x:Name="HeaderPresenter"
                                                  Grid.Column="1"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                                <Path x:Name="SubmenuArrow"
                                      Grid.Column="2"
                                      Width="5"
                                      Height="8"
                                      Margin="7,0,8,0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L5,4 L0,8 Z"
                                      Fill="{StaticResource DarkContextMenuSubtleForegroundBrush}"
                                      Stretch="Fill"
                                      Visibility="Collapsed" />
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Right"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       PopupAnimation="Fade">
                                    <Border Background="{StaticResource DarkContextMenuBackgroundBrush}"
                                            BorderBrush="{StaticResource DarkContextMenuBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="4">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsCheckable" Value="True">
                                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource DarkContextMenuHoverBrush}" />
                                <Setter TargetName="ItemBackground" Property="BorderBrush" Value="#314258" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource DarkContextMenuPressedBrush}" />
                                <Setter TargetName="ItemBackground" Property="BorderBrush" Value="#314258" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DarkContextMenuDisabledForegroundBrush}" />
                                <Setter TargetName="SubmenuArrow" Property="Fill" Value="{StaticResource DarkContextMenuDisabledForegroundBrush}" />
                                <Setter TargetName="CheckMark" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkContextMenuHoverBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DarkContextMenuForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkContextMenuPressedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DarkContextMenuForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DarkContextMenuDisabledForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource DarkContextMenuBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1"
                                Background="{TemplateBinding Background}"
                                Opacity="0.65" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
